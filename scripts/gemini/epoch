package main

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"net/http"
	"os"
	"os/exec"
	"strings"

	"google.golang.org/genai"
)

type Issue struct {
	Number int    `json:"number"`
	Title  string `json:"title"`
	Body   string `json:"body"`
}

func main() {
	ctx := context.Background()
	token := os.Getenv("GITHUB_TOKEN")
	repo := os.Getenv("GITHUB_REPOSITORY")
	apiKey := os.Getenv("GEMINI_API_KEY")

	if token == "" || repo == "" || apiKey == "" {
		fmt.Println("Missing required environment variables.")
		os.Exit(1)
	}

	// Fetch open Epoch Tasks
	issues, err := fetchEpochIssues(repo, token)
	if err != nil {
		fmt.Printf("Error fetching issues: %v\n", err)
		os.Exit(1)
	}

	if len(issues) == 0 {
		fmt.Println("No open epoch tasks found. Exiting.")
		return
	}

	target := issues[0]
	fmt.Printf("Processing Issue #%d: %s\n", target.Number, target.Title)

	// Initialize Gemini Client
	client, err := genai.NewClient(ctx, &genai.ClientConfig{
		APIKey:  apiKey,
		Backend: genai.BackendGeminiAPI,
	})
	if err != nil {
		fmt.Printf("Error creating Gemini client: %v\n", err)
		os.Exit(1)
	}

	prompt := fmt.Sprintf("Implement the following request for homelab infrastructure:\nTitle: %s\nBody: %s\nProvide clean code output.", target.Title, target.Body)

	resp, err := client.Models.GenerateContent(ctx, "gemini-2.5-flash", []*genai.Content{
		{Parts: []*genai.Part{{Text: prompt}}},
	}, nil)
	if err != nil {
		fmt.Printf("Error generating content: %v\n", err)
		os.Exit(1)
	}

	var answerText string
	for _, cand := range resp.Candidates {
		if cand.Content != nil {
			for _, part := range cand.Content.Parts {
				if part.Text != "" {
					answerText += part.Text
				}
			}
		}
	}

	// Git configuration and branch creation
	branchName := fmt.Sprintf("epoch/issue-%d", target.Number)
	runCmd("git", "config", "--global", "user.name", "gemini-bot[bot]")
	runCmd("git", "config", "--global", "user.email", "gemini-bot[bot]@users.noreply.github.com")
	runCmd("git", "checkout", "-b", branchName)

	outFile := "epoch_output.txt"
	_ = os.WriteFile(outFile, []byte(answerText), 0644)

	runCmd("git", "add", outFile)
	runCmd("git", "commit", "-m", fmt.Sprintf("feat: resolve epoch task #%d", target.Number))
	runCmd("git", "push", "origin", branchName)

	// Open Pull Request via GitHub REST API
	err = createPullRequest(repo, token, target.Number, target.Title, branchName)
	if err != nil {
		fmt.Printf("Error creating PR: %v\n", err)
		os.Exit(1)
	}

	fmt.Printf("Successfully opened Pull Request for issue #%d\n", target.Number)
}

func fetchEpochIssues(repo, token string) ([]Issue, error) {
	url := fmt.Sprintf("https://api.github.com/repos/%s/issues?labels=epoch-task&state=open", repo)
	req, _ := http.NewRequest("GET", url, nil)
	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Accept", "application/vnd.github+json")

	client := &http.Client{}
	res, err := client.Do(req)
	if err != nil {
		return nil, err
	}
	defer res.Body.Close()

	var issues []Issue
	err = json.NewDecoder(res.Body).Decode(&issues)
	return issues, err
}

func createPullRequest(repo, token string, issueNum int, title, branch string) error {
	url := fmt.Sprintf("https://api.github.com/repos/%s/pulls", repo)
	payload := map[string]string{
		"title": fmt.Sprintf("epoch: %s", title),
		"head":  branch,
		"base":  "main",
		"body":  fmt.Sprintf("Automated PR generated by Gemini Epoch Worker.\n\nCloses #%d", issueNum),
	}
	bodyBytes, _ := json.Marshal(payload)

	req, _ := http.NewRequest("POST", url, bytes.NewBuffer(bodyBytes))
	req.Header.Set("Authorization", "Bearer "+token)
	req.Header.Set("Accept", "application/vnd.github+json")
	req.Header.Set("Content-Type", "application/json")

	client := &http.Client{}
	res, err := client.Do(req)
	if err != nil {
		return err
	}
	defer res.Body.Close()

	if res.StatusCode != http.StatusCreated {
		return fmt.Errorf("github api returned status: %d", res.StatusCode)
	}
	return nil
}

func runCmd(name string, args ...string) {
	cmd := exec.Command(name, args...)
	cmd.Stdout = os.Stdout
	cmd.Stderr = os.Stderr
	if err := cmd.Run(); err != nil {
		fmt.Printf("Command failed: %s %s: %v\n", name, strings.Join(args, " "), err)
		os.Exit(1)
	}
}
