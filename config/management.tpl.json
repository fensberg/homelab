{
  "organization": {
    "name": "{{ op://homelab/organization/name }}"
  },
  "hypervisor": {
    "provider": "proxmox"
  },
  "fleet": "{{ op://homelab/topology/fleet }}",
  "source_control": {
    "repo_url": "{{ op://homelab/source-control/url }}",
    "token": "{{ op://homelab/source-control/token }}"
  },
  "overlay_network": {
    "provider": "tailscale",
    "domain": "{{ op://homelab/overlay-network/domain }}",
    "client_id": "{{ op://homelab/overlay-network/client_id }}",
    "client_secret": "{{ op://homelab/overlay-network/client_secret }}"
  },
  "object_storage": {
    "provider": "cloudflare",
    "account_id": "{{ op://homelab/object-storage/account_id }}",
    "admin_token": "{{ op://homelab/object-storage/admin_token/value }}",
    "access_key_id": "{{ op://homelab/object-storage/token/access_key_id }}",
    "secret_access_key": "{{ op://homelab/object-storage/token/secret_access_key }}",
    "bucket": "{{ op://homelab/object-storage/bucket }}"
  },
  "state": {
    "db_password": "{{ op://homelab/state-database/db_password }}",
    "backup_recipient": "{{ op://homelab/state-database/backup_recipient }}"
  }
}
