{
  "organization": {
    "name": "{{ op://homelab/organization/name }}"
  },

  "source_control": {
    "repo_url": "{{ op://homelab/source-control/url }}",
    "token": "{{ op://homelab/source-control/token }}"
  },

  "sites": [
    {
      "name": "{{ op://homelab/site0/name }}",
      "control_plane_count": 3,

      "hypervisor": {
        "provider": "proxmox",
        "token_id": "{{ op://homelab/site0-hypervisor/token_id }}",
        "token_secret": "{{ op://homelab/site0-hypervisor/token_secret }}",
        "nodes": [
          {
            "hostname": "{{ op://homelab/site0-node0/hostname }}",
            "ip": "{{ op://homelab/site0-node0/ip }}"
          }
        ]
      },

      "overlay_network": {
        "provider": "tailscale",
        "domain": "{{ op://homelab/site0-overlay-network/domain }}",
        "client_id": "{{ op://homelab/site0-overlay-network/client_id }}",
        "client_secret": "{{ op://homelab/site0-overlay-network/client_secret }}"
      },

      "object_storage": {
        "provider": "cloudflare",
        "account_id": "{{ op://homelab/site0-object-storage/account_id }}",
        "admin_token": "{{ op://homelab/site0-object-storage/admin_token }}",
        "access_key_id": "{{ op://homelab/site0-object-storage/access_key_id }}",
        "secret_access_key": "{{ op://homelab/site0-object-storage/secret_access_key }}",
        "bucket": "{{ op://homelab/site0-object-storage/bucket }}"
      },

      "state": {
        "db_password": "{{ op://homelab/site0-state-database/db_password }}",
        "backup_recipient": "{{ op://homelab/site0-state-database/backup_recipient }}"
      }
    }
  ]
}
