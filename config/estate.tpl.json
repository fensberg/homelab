{
  "organization": {
    "name": "{{ op://estate-shared/organization/name }}",
    "domain": "{{ op://estate-shared/organization/domain }}"
  },

  "source_control": {
    "provider": "github",
    "url": "{{ op://estate-shared/source-control/url }}",
    "app_id": "{{ op://estate/source-control/app_id }}",
    "installation_id": "{{ op://estate/source-control/installation_id }}",
    "private_key": "{{ op://estate/source-control/private_key }}",
    "billing_email": "{{ op://estate/source-control/billing_email }}",
    "procurement_app_id": "{{ op://estate-shared/source-control/procurement-bot/app_id }}",
    "pull_request_runners_site": "site0"
  },

  "access": {
    "provider": "cloudflare",
    "vault_provider": "{{ op://estate/access/provider }}",
    "account_id": "{{ op://estate/access/account_id }}",
    "api_token": "{{ op://estate/access/api_token }}",
    "workers_subdomain": "{{ op://estate/access/workers_subdomain }}",
    "members": "{{ op://estate/access/members }}"
  },

  "alerting": {
    "provider": "slack",
    "webhook_url": "{{ op://estate-shared/alerting/webhook_url }}"
  },

  "state": {
    "bucket": "{{ op://estate/state/bucket }}",
    "access_key_id": "{{ op://estate/state/access_key_id }}",
    "secret_access_key": "{{ op://estate/state/secret_access_key }}"
  },

  "workstation": {
    "address": "198.18.0.1"
  },

  "plots": {
    "site0": {
      "name": "{{ op://estate/site0/name }}"
    }
  }
