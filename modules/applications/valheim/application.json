{
  "_comment": [
    "What the estate's general mechanisms need to know about this application.",
    "README.md beside this file says what each part is for."
  ],
  "requires": [],
  "routes": {
    "game-server": 46
  },
  "secrets": {
    "valheim-server": {
      "server-name": { "vault": "server_name" },
      "world-name": { "vault": "name" },
      "password": { "vault": "password" }
    },
    "valheim-backup": {
      "RCLONE_CONFIG_R2_TYPE": { "value": "s3" },
      "RCLONE_CONFIG_R2_PROVIDER": { "value": "Cloudflare" },
      "RCLONE_CONFIG_R2_ACCESS_KEY_ID": { "storage": "access_key_id" },
      "RCLONE_CONFIG_R2_SECRET_ACCESS_KEY": { "storage": "secret_access_key" },
      "RCLONE_CONFIG_R2_ENDPOINT": { "storage": "endpoint" },
      "RCLONE_CONFIG_R2_NO_CHECK_BUCKET": { "value": "true" },
      "WORLD_BACKUP_BUCKET": { "storage": "bucket" },
      "WORLD_BACKUP_KEY": { "generated": "backup_key" }
    }
  },
  "release": {
    "version": {
      "env": ["VALHEIM_PASSWORD", "VALHEIM_SERVER_NAME", "VALHEIM_WORLD_NAME"],
      "pattern": "Valheim version: [a-z]*-\\{0,1\\}\\([0-9][0-9.]*\\)",
      "example": {
        "line": "09/23/2026 13:45:43: Valheim version: l-1.0.15 (network version 40)",
        "version": "1.0.15"
      }
    }
  },
  "upstream": {
    "kind": "steam",
    "app": "896660",
    "news": "892970",
    "pin": "VALHEIM_STEAM_BUILD_VERSION"
  },
  "sized_from": {
    "Deployment/valheim": {
      "valheim": {
        "kind": "publisher",
        "basis": "Memory is the publisher's guidance: 4 GiB for a new world at this player count, 6 to 8 once it has been explored and built on. The four processors are this estate's own choice. Neither has been seen under load: no player was logged in for the first window it was watched over."
      },
      "world-backup": {
        "kind": "estimate",
        "basis": "Chosen for rclone copying a world of tens of megabytes; never seen under load."
      },
      "world-restore": {
        "kind": "estimate",
        "basis": "The same work as the backup, in the other direction, once at start."
      }
    }
  },
  "holds": [
    {
      "what": "the world",
      "lifetime": "client",
      "lives_on": "machine",
      "held_by": "PersistentVolumeClaim/world",
      "copy": { "under": "worlds" },
      "may_lose": "2h"
    }
  ],
  "before_teardown": {
    "what": "the world",
    "selector": "app.kubernetes.io/name=valheim",
    "container": "world-backup",
    "command": [
      "/bin/sh",
      "-c",
      "WORLD_BACKUP_ONCE=1 exec /usr/local/bin/world-backup"
    ]
  }
}
