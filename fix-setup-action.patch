   pull_request:
     branches:
       - main
+      # Epoch branches are pull request targets too. Work now lands on the
+      # epoch's branch and the epoch lands on main, so filtering to main alone
+      # meant a pull request into an epoch got two checks out of ten - not the
+      # eight lanes that decide whether it is correct - and everything would be
+      # validated for the first time in one lump when the epoch itself opened.
+      # That is the opposite of shifting left, and it is how #73 came to sit
+      # green with its whole validation suite never having run.
+      - "epoch/**"

