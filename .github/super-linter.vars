# Super-Linter configuration, shared by CI and `task lint`.
#
# Both read this file, so the two cannot drift. A local run that passes while
# CI fails on the same code is the least useful failure there is.

# Named .vars rather than .env on purpose: Super-Linter runs dotenv-linter over
# anything ending in .env, and dotenv-linter demands that a value containing
# spaces be quoted - but docker --env-file treats quotes as part of the value,
# which would break the kubeconform options below.

# CI lints the diff; a local run lints everything (RUN_LOCAL forces it).
VALIDATE_ALL_CODEBASE=false

# Biome is a JavaScript toolchain. There is no JavaScript here.
VALIDATE_BIOME_LINT=false
VALIDATE_BIOME_FORMAT=false

# Copy-paste detection flags the repeated harden-runner and checkout blocks in
# every workflow job, which is how workflows are written.
VALIDATE_JSCPD=false

# Everything under clusters/ is a Flux template, not a manifest.
# --ignore-missing-schemas covers the Flux and CloudNativePG CRDs, which
# kubeconform has no schema for. state-database.yaml needs more than that: its
# nodePort is a placeholder Flux substitutes at reconcile time, so statically
# it is a string in a field the schema requires to be an integer. Quoting it to
# satisfy the linter would make the substituted value a string too, which
# Kubernetes rejects - so the file is skipped, and Flux's own server-side
# validation is what checks it.
KUBERNETES_KUBECONFORM_OPTIONS=--ignore-missing-schemas --ignore-filename-pattern state-database.yaml
