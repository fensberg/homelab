# Super-Linter settings, read by both CI and `task lint`.
#
# Named .vars rather than .env on purpose: Super-Linter runs dotenv-linter over
# anything ending in .env, and dotenv-linter demands that a value containing
# spaces be quoted - but docker --env-file treats quotes as part of the value.
#
# Super-Linter owns ANALYSIS: checkov, ansible-lint, tflint, shellcheck,
# markdownlint, yamllint, PSScriptAnalyzer, zizmor. Everything switched off
# below is off because something faster already owns it, and two owners means
# two versions and a pull request that fails on a check that passed locally.

# --- owned by .pre-commit-config.yaml ---------------------------------------
# prettier, shfmt, tofu fmt and actionlint all run there, pinned exactly, and
# the Format job in CI runs that same file.
VALIDATE_JSON_PRETTIER=false
VALIDATE_YAML_PRETTIER=false
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_SHELL_SHFMT=false
VALIDATE_TERRAFORM_FMT=false
VALIDATE_GITHUB_ACTIONS=false

# --- owned by the Validate job ----------------------------------------------
# kubeconform here could only ever see the raw templates, which is why it had
# to be told to ignore missing CRD schemas and skip state-database.yaml
# outright. The Validate job builds the kustomization and substitutes the
# placeholders first, so it checks the manifests Flux will actually apply.
VALIDATE_KUBERNETES_KUBECONFORM=false

# The dedicated IaC Scan (Trivy) job below owns Trivy: it already excludes
# clusters/management/flux-system/ correctly (skip-dirs, not
# FILTER_REGEX_EXCLUDE, which Trivy - like Checkov - ignores entirely per
# Super-Linter's own docs), and running it twice with two different configs
# is exactly the failure mode that put an unformatted 11k-line file on a PR
# that pre-commit had already passed. See pr-validation.yml's trivy job for
# why scan-type fs + scanners vuln,misconfig there covers everything this
# bundled invocation would have.
VALIDATE_TRIVY=false

# In diff mode, Super-Linter hands golangci-lint a flat list of changed Go
# files. When those files span more than one package directory, go/packages
# rejects the list outright ("named files must all be in one directory") -
# a confirmed upstream bug (super-linter/super-linter#6294), not something
# fixable here. `go vet`/`go build` in the Validate job work on whole
# packages instead, so they are not exposed to that bug and are not
# diff-limited either.
VALIDATE_GO=false
VALIDATE_GO_MODULES=false

# --- no value here ----------------------------------------------------------
# Biome is a JavaScript toolchain. There is no JavaScript here.
VALIDATE_BIOME_LINT=false
VALIDATE_BIOME_FORMAT=false

# Copy-paste detection flags the repeated harden-runner and checkout blocks in
# every workflow job, which is how workflows are written.
VALIDATE_JSCPD=false

# textlint's terminology list is written for product prose. In an
# infrastructure repository it objects to "repo", "git", "VS Code",
# "copy-paste" and "file names" - all correct here - and it catches no defect.
VALIDATE_NATURAL_LANGUAGE=false

# clusters/management/flux-system/ is Flux's own generated install and sync
# manifest (gotk-components.yaml, gotk-sync.yaml), committed verbatim so it
# goes through normal PR review like everything else - see docs/epochs for
# why. It is not ours to edit: checkov and codespell findings inside it are
# findings about Flux's own upstream manifest, not this codebase, and the
# broad ClusterRole permissions checkov flags are inherent to how a GitOps
# controller has to work (it cannot reconcile arbitrary resource types
# without broad access) - not something a smaller grant would fix without
# breaking Flux. Structural validity is still checked separately by the
# Validate job's kubeconform pass, which this exclusion does not affect.
FILTER_REGEX_EXCLUDE=clusters/management/flux-system/.*
