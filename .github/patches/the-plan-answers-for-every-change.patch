@@ -327,3 +383,62 @@ jobs:
           RESULT: ${{ needs.plan.result }}
         with:
           name: plan-absence-comment
+
+  # ---------------------------------------------------------------------
+  # PLAN - the one answer for the whole change, and the check a merge is
+  # held to.
+  #
+  # The jobs above are one per site and are skipped for a change that needs
+  # no plan, and a check that is skipped or absent cannot be required: the
+  # platform waits on it for ever. This job always runs and always answers.
+  #
+  #   - A change that touches nothing a site is built from passes, with
+  #     nothing planned.
+  #   - A change that was planned passes when every site's plan did, and
+  #     fails when any was refused or could not be made.
+  #   - A change that should have been planned and was not - a fork's, which
+  #     has no record to plan against - fails. A plan that could not be made
+  #     is not a plan that came out well.
+  #
+  # It checks nothing out and holds no token.
+  # ---------------------------------------------------------------------
+  held:
+    name: Plan
+    needs: [sites, plan]
+    if: always() && github.event.action != 'closed'
+    runs-on: ubuntu-latest
+    permissions: {}
+    timeout-minutes: 5
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # Owned by scripts/approved-suppliers.yml under `egress:`.
+          egress-policy: block
+          disable-sudo-and-containers: "true"
+          allowed-endpoints: >
+            api.github.com:443
+            github.com:443
+          checkout: "false"
+
+      - name: Whether this change may land
+        env:
+          SITES: ${{ needs.sites.result }}
+          TOUCHED: ${{ needs.sites.outputs.touched }}
+          PLAN: ${{ needs.plan.result }}
+        run: |
+          set -euo pipefail
+          if [ "${SITES}" != "success" ]; then
+            echo "::error::it could not be worked out whether this change needs a plan (${SITES}), so it is not passed"
+            exit 1
+          fi
+          if [ "${TOUCHED}" != "true" ]; then
+            echo "this change touches nothing a site is built from: nothing to plan"
+            exit 0
+          fi
+          if [ "${PLAN}" = "success" ]; then
+            echo "every site's plan was made and none refused the change"
+            exit 0
+          fi
+          echo "::error::this change touches what a site is built from and its plan was ${PLAN}. The plan's comment on the pull request leads with why"
+          exit 1
