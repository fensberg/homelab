+		"west":  deliverySource("other", "1.0.0-1", 'c', "") + deliverySource("thing", "2.4.0-9", 'a', ""),
+		"south": deliverySource("thing", "2.4.1-2", 'a', hold),
+		"east":  deliverySource("other", "1.0.0-1", 'c', ""),
+	})
+	ok, summary, logs := f.deliver(t)
