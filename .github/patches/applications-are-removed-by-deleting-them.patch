+	keys := a.Secrets["thing-keys"]
+	if keys["user"].Vault != "user" || keys["key"].Generated != "backup_key" || keys["where"].Storage != "bucket" || keys["kind"].Value == nil || *keys["kind"].Value != "" {
+		t.Errorf("secrets were read as %+v", keys)
