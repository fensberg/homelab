+		"a digest alone":     {"    digest: \"" + digest + "\"\n", []string{"has no tag"}},
+		"a digest cut short": {"    tag: \"1.0.0-1\"\n    digest: \"sha256:abc\"\n", []string{"is not pinned by digest"}},
+		"nothing pinned":     {"    semver: \"*\"\n", []string{"is not pinned by digest", "has no tag"}},
