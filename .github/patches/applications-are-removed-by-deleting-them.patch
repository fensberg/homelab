+	// Every site that follows already runs it: nothing is opened.
+	f = newReleaseDelivery(t, map[string]string{
+		"north": deliverySource("thing", "2.4.1-3", 'b', ""),
+		"south": deliverySource("thing", "2.4.1-2", 'a', hold),
+	})
