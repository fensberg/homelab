diff --git a/.github/workflows/deliver-modules.yml b/.github/workflows/deliver-modules.yml
new file mode 100644
index 0000000..542e00a
--- /dev/null
+++ b/.github/workflows/deliver-modules.yml
@@ -0,0 +1,153 @@
+name: Deliver Modules
+# Brings a change to what a site runs to the estate's gate.
+#
+# A site runs the estate's modules as they were at a pinned commit
+# (management/pins.json), so a change to a module reaches no site on the
+# merge that made it. It reaches them when the default pin moves, and that
+# was a line somebody edited by hand in a second pull request (#602). After
+# every merge to main this asks procurement whether anything a pinned tree is
+# read for differs between the pin and the commit that merged - the modules,
+# and whatever they reach outside themselves - and when it does, opens the
+# pull request that moves the default to it.
+#
+# NO PATH FILTER, on purpose. Which paths count is read off the modules by
+# `procurement deliver-modules`, so a module that starts reading something
+# new is seen without anybody adding it to a list here. A merge that changed
+# nothing a site reads costs one short run that says so.
+#
+# IT MOVES NOTHING ITSELF. Merging the pull request is what moves the sites:
+# its plan shows what the move does to each one, the merge converges them,
+# and it is a person's to merge. `superintendent enforce-standing-order`
+# passes it on the pull request and refuses it for any merge without a
+# review. A site held at a commit of its own is not moved by it.
+on:
+  push:
+    branches: [main]
+# Read at the top. The one job mints procurement's own token for what it
+# writes, so nothing here needs more of this workflow's.
+permissions:
+  contents: read
+# One at a time. Two runs proposing the same move would open the same pull
+# request twice.
+concurrency:
+  group: deliver-modules
+  cancel-in-progress: false
+# GitHub's default shell for `run:` is `bash -e {0}`, which has no pipefail.
+# tests/go/repo/pipefail_test.go asserts this is present on every workflow.
+defaults:
+  run:
+    shell: bash
+jobs:
+  deliver:
+    name: Bring the modules to the gate
+    runs-on: ubuntu-latest
+    # Bounded so a stuck job cannot bill a metered vendor for six hours, which
+    # is what GitHub's default timeout allows.
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # Owned by scripts/approved-suppliers.yml under `egress:`, which says
+          # which job may reach what; `security guard-egress` refuses any drift.
+          # The copy lives here because harden-runner reads its policy in a
+          # pre-step, before any step of this job can run.
+          egress-policy: block
+          disable-sudo-and-containers: "true"
+          allowed-endpoints: >
+            api.github.com:443
+            github.com:443
+            go.dev:443
+            objects.githubusercontent.com:443
+            proxy.golang.org:443
+            release-assets.githubusercontent.com:443
+            storage.googleapis.com:443
+            sum.golang.org:443
+
+      # Versions come from scripts/versions.env, which is the only place one
+      # is written. See .github/actions/versions for why this is a step
+      # rather than a setup job.
+      - name: Read pinned versions
+        uses: ./.github/actions/versions
+
+      - name: Setup Go
+        uses: $/.github/workflows/setup-go
+
+      - name: Mint the procurement token
+        id: token
+        uses: $/.github/workflows/app-token
+        with:
+          client-id: ${{ secrets.PROCUREMENT_BOT_CLIENT_ID }}
+          private-key: ${{ secrets.PROCUREMENT_BOT_PRIVATE_KEY }}
+          # Contents to commit the moved pin; pull requests to open the
+          # delivery and close the one it supersedes. Nothing else the App was
+          # granted at installation.
+          permission-contents: write
+          permission-pull-requests: write
+          owner: ${{ github.repository_owner }}
+          repositories: ${{ github.event.repository.name }}
+
+      # Through the API rather than git push: a commit created there is signed
+      # by GitHub on the App's behalf, which the ruleset requiring signatures
+      # on every branch accepts. One pull request per commit the pin would
+      # move to, on a branch named for it; an older one still open is closed,
+      # because branches here cannot be force-updated and the newer commit
+      # holds everything the older one did.
+      - name: Deliver
+        env:
+          GH_TOKEN: ${{ steps.token.outputs.token }}
+          REPO: ${{ github.repository }}
+          PINS: management/pins.json
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          # Main as it is now, not the commit this run started for: main can
+          # have moved since, the pull request's parent is main, and the pin
+          # should name the newest commit that holds the change.
+          main="$(gh api "repos/${REPO}/git/ref/heads/main" --jq .object.sha)"
+          base_tree="$(gh api "repos/${REPO}/git/commits/${main}" --jq .tree.sha)"
+          git fetch --quiet --no-tags --depth=1 origin "$main"
+          git checkout --quiet --detach "$main"
+
+          # The verb moves the default in the copy when what a site reads
+          # differs between the pin and main, and leaves the copy alone when
+          # nothing does.
+          cp "$PINS" "$RUNNER_TEMP/pins.json"
+          before="$(sha256sum < "$RUNNER_TEMP/pins.json")"
+          said="$(go run -C scripts/procurement . deliver-modules -pins "$RUNNER_TEMP/pins.json" -to "$main")"
+          echo "$said" >> "$GITHUB_STEP_SUMMARY"
+          if [ "$(sha256sum < "$RUNNER_TEMP/pins.json")" = "$before" ]; then
+            exit 0
+          fi
+
+          short="${main:0:7}"
+          branch="pin/${main}"
+          if [ -n "$(gh pr list --repo "$REPO" --head "$branch" --state open --json number --jq '.[0].number // empty')" ]; then
+            echo "the move to ${short} is already at the gate" >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+
+          blob="$(gh api "repos/${REPO}/git/blobs" -f content="$(base64 -w0 "$RUNNER_TEMP/pins.json")" -f encoding=base64 --jq .sha)"
+          tree="$(gh api "repos/${REPO}/git/trees" -f base_tree="$base_tree" \
+            -f "tree[][path]=${PINS}" -f "tree[][mode]=100644" -f "tree[][type]=blob" -f "tree[][sha]=${blob}" --jq .sha)"
+          title="feat: the sites run the modules as of ${short}"
+          commit="$(gh api "repos/${REPO}/git/commits" -f tree="$tree" -f "parents[]=${main}" -f message="$title" --jq .sha)"
+          gh api "repos/${REPO}/git/refs" -f ref="refs/heads/${branch}" -f sha="$commit" >/dev/null
+          url="$(gh pr create --repo "$REPO" --base main --head "$branch" --title "$title" \
+            --body "$(printf '%s\n' \
+              "## Actions for you" "" \
+              "Read the plan on this pull request: it shows what moving the pin does to each site. Merging converges every site that has no pin of its own." "" \
+              "## What this is" "" \
+              "A change to what a site runs merged as \`${main}\`, and no site runs it until the estate's default pin names it. This moves the default in \`${PINS}\` to that commit, and changes nothing else." "" \
+              "${said}" "" \
+              "Procurement opened this; it is never merged without review." "" \
+              "Delivered by: ${RUN_URL}")")"
+          echo "the move to ${short} is delivered as ${url##*/}" >> "$GITHUB_STEP_SUMMARY"
+
+          # Older moves are superseded by this one.
+          gh pr list --repo "$REPO" --state open --json number,headRefName \
+            --jq ".[] | select(.headRefName | startswith(\"pin/\")) | select(.headRefName != \"${branch}\") | .number" \
+            | while IFS= read -r old; do
+                gh pr close "$old" --repo "$REPO" --delete-branch --comment "Superseded by ${url##*/}, which moves the pin to a newer commit." >/dev/null
+              done
