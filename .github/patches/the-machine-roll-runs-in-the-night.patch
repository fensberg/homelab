+      - name: Roll
+        id: roll
+        env:
+          OP_SERVICE_ACCOUNT_TOKEN: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
+          GITHUB_TOKEN: ${{ github.token }}
+          SITE: ${{ matrix.site }}
+        run: |
+          # The access lives in this directory for the length of the run and
+          # no longer; op run hands it to the play and masks it in the log.
+          workdir="$(mktemp -d)"
+          trap 'rm -rf "$workdir"' EXIT
+          printf 'TALOS_ACCESS=op://%s/talos/talosconfig\n' "$SITE" > "$workdir/vault.env"
+          ROLL_WORKDIR="$workdir" op run --env-file "$workdir/vault.env" -- \
+            ansible-playbook management/roll/talos-upgrade.yml 2>&1 | tee roll.log
+
+      # The play's own words where it stopped, for the issue the aftermath
+      # opens. What the play prints is structure: machines, versions, checks.
+      - name: Record why it stopped
+        if: failure()
+        run: |
+          grep -m1 '^fatal:' roll.log | sed 's/^[^{]*//' | jq -r '.msg // "The roll stopped without saying why."' > roll-why.txt || echo "The roll stopped without saying why." > roll-why.txt
+
+      - name: Keep why it stopped
+        if: failure()
+        uses: $/.github/workflows/upload-artifact
+        with:
+          name: roll-why-${{ matrix.site }}
+          path: roll-why.txt
+          if-no-files-found: ignore
+          retention-days: 7
+
+  # The machine the first job ran on, which it cordoned rather than drain
+  # under itself. This job is placed elsewhere because that machine is
+  # cordoned, and finishes it.
+  roll-handover:
+    name: Roll ${{ matrix.site }}, its last machine
+    needs: [changes, roll]
+    if: needs.roll.outputs.handed_over == 'true'
+    runs-on: homelab-${{ matrix.site }}
+    environment: management
+    permissions:
+      contents: read
+      actions: write
+    timeout-minutes: 90
+    strategy:
+      fail-fast: false
+      matrix:
+        site: ${{ fromJSON(needs.changes.outputs.sites) }}
+    outputs:
+      touched: ${{ steps.roll.outputs.touched }}
+      machine: ${{ steps.roll.outputs.machine }}
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # As the roll's, for its reason.
+          egress-policy: audit
+          disable-sudo-and-containers: "false"
+
+      - name: Read pinned versions
+        uses: $/.github/actions/versions
+
+      - name: Take delivery of the roll's tools
+        run: scripts/take-delivery.sh ansible-core kubernetes kubernetes-core
+
+      - name: Roll
+        id: roll
+        env:
+          OP_SERVICE_ACCOUNT_TOKEN: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
+          GITHUB_TOKEN: ${{ github.token }}
+          SITE: ${{ matrix.site }}
+        run: |
+          workdir="$(mktemp -d)"
+          trap 'rm -rf "$workdir"' EXIT
+          printf 'TALOS_ACCESS=op://%s/talos/talosconfig\n' "$SITE" > "$workdir/vault.env"
+          ROLL_WORKDIR="$workdir" op run --env-file "$workdir/vault.env" -- \
+            ansible-playbook management/roll/talos-upgrade.yml 2>&1 | tee roll.log
+
+      - name: Record why it stopped
+        if: failure()
+        run: |
+          grep -m1 '^fatal:' roll.log | sed 's/^[^{]*//' | jq -r '.msg // "The roll stopped without saying why."' > roll-why.txt || echo "The roll stopped without saying why." > roll-why.txt
+
+      - name: Keep why it stopped
+        if: failure()
+        uses: $/.github/workflows/upload-artifact
+        with:
+          name: roll-why-${{ matrix.site }}
+          path: roll-why.txt
