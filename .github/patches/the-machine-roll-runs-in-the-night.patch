+      fail-fast: false
+      matrix:
+        site: ${{ fromJSON(needs.changes.outputs.sites) }}
+    outputs:
+      handed_over: ${{ steps.roll.outputs.handed_over }}
+      touched: ${{ steps.roll.outputs.touched }}
+      machine: ${{ steps.roll.outputs.machine }}
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
