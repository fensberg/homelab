+
+  # ---------------------------------------------------------------------
+  # A ROLL THAT STOPPED - said where somebody will see it, and nothing
+  # retried. Like the converge's aftermath, on GitHub's runner, holding
+  # nothing that reaches the estate.
+  #
+  # A roll that refused before its first machine changed nothing: an issue
+  # says why, and the next night's run asks again. One that stopped part-way
+  # left that machine cordoned: an issue says which, and when the bump was a
+  # patch release a pull request reverting it is opened, for the operator to
+  # merge or not. Reverted, the next window rolls the moved machines back.
+  # Across a minor version there is no revert: Talos goes forward only.
+  # ---------------------------------------------------------------------
+  roll-aftermath:
+    name: Roll aftermath
+    needs: [roll, roll-handover]
+    if: always() && (needs.roll.result == 'failure' || needs.roll-handover.result == 'failure')
+    runs-on: ubuntu-latest
+    permissions:
+      contents: read
+      issues: write
+    timeout-minutes: 10
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # Owned by scripts/approved-suppliers.yml under `egress:`, which says
+          # which job may reach what; `security guard-egress` refuses any drift.
+          # The copy lives here because harden-runner reads its policy in a
+          # pre-step, before any step of this job can run.
+          egress-policy: block
+          disable-sudo-and-containers: "true"
+          allowed-endpoints: >
+            api.github.com:443
+            github.com:443
+            objects.githubusercontent.com:443
+            release-assets.githubusercontent.com:443
+          fetch-depth: 0
+
+      - name: Collect why it stopped
+        uses: $/.github/workflows/download-artifact
+        with:
+          pattern: roll-why-*
+          path: why
+          merge-multiple: true
+
+      - name: Decide what a revert would be
+        id: bump
+        env:
+          TOUCHED: ${{ needs.roll-handover.outputs.touched || needs.roll.outputs.touched }}
+        run: |
+          # The change that moved the machines: the last commit to touch the
+          # module that declares their version.
+          sha=$(git log -1 --format=%H -- modules/infrastructure/machine-image/)
+          version=$(sed -n 's/^ *talos_version *= *"\(v[0-9.]*\)".*/\1/p' modules/infrastructure/machine-image/machine-image.tf)
+          from=$(sed -n 's/^ *talos_upgrades_from *= *"\(v[0-9.]*\)".*/\1/p' modules/infrastructure/machine-image/machine-image.tf)
+          patch=false
+          [ "${version%.*}" = "$from" ] && patch=true
+          {
+            echo "sha=$sha"
+            echo "version=$version"
+            echo "revertible=$([ "$TOUCHED" = true ] && [ "$patch" = true ] && echo true || echo false)"
+          } >> "$GITHUB_OUTPUT"
+
+      - name: Mint the revert token
+        id: revert-token
+        if: steps.bump.outputs.revertible == 'true'
+        uses: $/.github/workflows/app-token
+        with:
+          client-id: ${{ secrets.PROCUREMENT_BOT_CLIENT_ID }}
+          private-key: ${{ secrets.PROCUREMENT_BOT_PRIVATE_KEY }}
+          permission-contents: write
+          permission-pull-requests: write
+          owner: ${{ github.repository_owner }}
+          repositories: ${{ github.event.repository.name }}
+
+      # The module put back as it was before the bump, and nothing else: the
+      # tree is main's with that one directory swapped, signed by GitHub as
+      # the converge's revert is. A pull request, never merged here.
+      - name: Offer a revert of the bump
+        id: revert
+        if: steps.bump.outputs.revertible == 'true'
+        env:
+          GH_TOKEN: ${{ steps.revert-token.outputs.token }}
+          SHA: ${{ steps.bump.outputs.sha }}
+          VERSION: ${{ steps.bump.outputs.version }}
+          REPO: ${{ github.repository }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          before=$(git rev-parse "$SHA^:modules/infrastructure/machine-image")
+          tree=$(gh api "repos/$REPO/git/trees" \
+            -f base_tree="$(git rev-parse "HEAD^{tree}")" \
+            -f "tree[][path]=modules/infrastructure/machine-image" \
+            -f "tree[][mode]=040000" \
+            -f "tree[][type]=tree" \
+            -f "tree[][sha]=$before" \
+            --jq .sha)
+          commit=$(gh api "repos/$REPO/git/commits" \
+            -f message="revert: the machines go back from Talos $VERSION" \
+            -f tree="$tree" \
+            -f "parents[]=$(git rev-parse HEAD)" \
+            --jq .sha)
+          branch="revert/roll-stopped-${SHA::8}"
+          gh api "repos/$REPO/git/refs" -f ref="refs/heads/$branch" -f sha="$commit" >/dev/null
+          url=$(gh pr create --draft --base main --head "$branch" \
+            --title "revert: the machine roll to Talos $VERSION stopped" \
+            --body "$(printf '%s\n' \
+              "The machine roll to Talos $VERSION stopped part-way. Merging this puts modules/infrastructure/machine-image back as it was before ${SHA::8}; the next window then rolls the machines already moved back to the version before, the same way they went forward. Talos moves between patch versions in either direction." \
+              "" \
+              "**Do not merge it if the failure is not the version's** - a runner, the cluster, a check of the roll's own. Read the issue the roll opened, and the run, first." \
+              "" \
+              "Run: $RUN_URL")")
+          echo "url=$url" >> "$GITHUB_OUTPUT"
+
+      - name: Say the roll stopped
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          TOUCHED: ${{ needs.roll-handover.outputs.touched || needs.roll.outputs.touched }}
+          MACHINE: ${{ needs.roll-handover.outputs.machine || needs.roll.outputs.machine }}
+          VERSION: ${{ steps.bump.outputs.version }}
+          REVERT: ${{ steps.revert.outputs.url }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          why="$(cat why/roll-why.txt 2>/dev/null || echo 'The roll left no account of why it stopped. Read the run.')"
