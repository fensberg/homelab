+  # ---------------------------------------------------------------------
+  # THE MACHINE ROLL - every machine moved to the Talos the cluster says it
+  # should run, one at a time, in the night's window (management/roll).
+  #
+  # On the site's own runners, holding the converge's credential and its
+  # lock: the play reads the Talos client configuration the converge keeps in
+  # the site's vault, through op run, for as long as the run. Most runs find
+  # the window shut or nothing behind and are over in a minute.
+  # ---------------------------------------------------------------------
+  roll:
+    name: Roll ${{ matrix.site }}
+    needs: changes
+    if: github.event_name == 'schedule'
+    runs-on: homelab-${{ matrix.site }}
+    environment: management
+    permissions:
+      contents: read
+      # To start the integration tier against the site and read how it went,
+      # and to read which jobs passed on the canary.
