diff --git a/.github/workflows/setup-go/action.yml b/.github/workflows/setup-go/action.yml
new file mode 100644
index 0000000..06a1d6c
--- /dev/null
+++ b/.github/workflows/setup-go/action.yml
@@ -0,0 +1,36 @@
+# The one place the actions/setup-go commit is written.
+#
+# The Go version is not an input. It is read from GO_VERSION, which
+# .github/actions/versions exports from scripts/versions.env - the one place a
+# version is pinned. Taking it as an input would give every caller a way to
+# restate it, which is the drift that file exists to refuse. A job that has not
+# exported it is refused rather than handed whatever Go the runner image holds.
+name: "Setup Go"
+description: Install the Go version pinned in scripts/versions.env.
+
+inputs:
+  cache-dependency-path:
+    description: >-
+      A go.sum to key the module cache on. Empty means no cache, which is right
+      for a module with no dependencies - and on a self-hosted runner a cache
+      persists between jobs, which is a poisoning surface for no benefit.
+    required: false
+    default: ""
+
+runs:
+  using: composite
+  steps:
+    - name: Refuse to guess the Go version
+      shell: bash
+      run: |
+        if [ -z "${GO_VERSION:-}" ]; then
+          echo "::error::GO_VERSION is not set. Run \`uses: ./.github/actions/versions\` before this step; the version is pinned in scripts/versions.env and nowhere else."
+          exit 1
+        fi
+
+    - name: Setup Go
+      uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
+      with:
+        go-version: ${{ env.GO_VERSION }}
+        cache: ${{ inputs.cache-dependency-path != '' }}
+        cache-dependency-path: ${{ inputs.cache-dependency-path }}
diff --git a/.github/workflows/upload-sarif/action.yml b/.github/workflows/upload-sarif/action.yml
new file mode 100644
index 0000000..1ce86ac
--- /dev/null
+++ b/.github/workflows/upload-sarif/action.yml
@@ -0,0 +1,38 @@
+# The one place the github/codeql-action/upload-sarif commit is written.
+#
+# codeql-action's init and analyze are each used once, in codeql.yml, and stay
+# there. tests/go/repo/action_pins_test.go requires every path of one action
+# repository to carry the same commit, so this and those cannot drift apart.
+#
+# Empty ref, sha and category are passed through as empty, which codeql-action
+# reads as unset (getOptionalInput returns undefined for an empty string).
+name: "Upload SARIF"
+description: Upload a SARIF file to code scanning.
+
+inputs:
+  sarif_file:
+    description: The SARIF file to upload.
+    required: true
+  category:
+    description: Distinguishes this upload from others for the same commit.
+    required: false
+    default: ""
+  ref:
+    description: The ref the results belong to; empty means the triggering ref.
+    required: false
+    default: ""
+  sha:
+    description: The commit the results belong to; empty means the triggering commit.
+    required: false
+    default: ""
+
+runs:
+  using: composite
+  steps:
+    - name: Upload SARIF
+      uses: github/codeql-action/upload-sarif@c16c0f3f2812ec4bb3750a5ed64873fe2ce0fbef # codeql-bundle-v2.26.3
+      with:
+        sarif_file: ${{ inputs.sarif_file }}
+        category: ${{ inputs.category }}
+        ref: ${{ inputs.ref }}
+        sha: ${{ inputs.sha }}
