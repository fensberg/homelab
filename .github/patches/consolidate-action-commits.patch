diff --git a/.github/workflows/app-token/action.yml b/.github/workflows/app-token/action.yml
new file mode 100644
index 0000000..fb41d00
--- /dev/null
+++ b/.github/workflows/app-token/action.yml
@@ -0,0 +1,80 @@
+# The one place the actions/create-github-app-token commit is written.
+#
+# EVERY PERMISSION IS EXPLICIT, AND NONE AT ALL IS REFUSED. The action requests
+# only the permissions it is given - and when it is given none, it requests
+# every permission the installation holds
+# (lib/get-permissions-from-inputs.js: "Inherit app permissions if no
+# permissions inputs are set"). A wrapper whose permission inputs all default
+# to empty would turn a caller that forgot to name one into a token with
+# everything, silently. So the first step refuses that.
+#
+# Only the permissions some job here actually requests are inputs. A job that
+# needs another has to add it here, in a reviewed change, rather than reaching
+# for it through the wrapper.
+#
+# The token is revoked in the action's post-step, which runs for an action
+# nested under `$/` - shown by "Post Mobilize" running harden-runner's own.
+name: "App Token"
+description: Mint a GitHub App installation token with explicitly named permissions.
+
+inputs:
+  client-id:
+    description: The App's ID or client ID.
+    required: true
+  private-key:
+    description: The App's private key.
+    required: true
+  owner:
+    description: The installation's owner.
+    required: true
+  repositories:
+    description: The repositories the token may reach.
+    required: true
+  permission-contents:
+    description: read or write, or empty for none.
+    required: false
+    default: ""
+  permission-pull-requests:
+    description: read or write, or empty for none.
+    required: false
+    default: ""
+  permission-checks:
+    description: read or write, or empty for none.
+    required: false
+    default: ""
+  permission-statuses:
+    description: read or write, or empty for none.
+    required: false
+    default: ""
+
+outputs:
+  token:
+    description: The installation token.
+    value: ${{ steps.mint.outputs.token }}
+
+runs:
+  using: composite
+  steps:
+    - name: Refuse a token with no named permission
+      if: >-
+        inputs.permission-contents == '' &&
+        inputs.permission-pull-requests == '' &&
+        inputs.permission-checks == '' &&
+        inputs.permission-statuses == ''
+      shell: bash
+      run: |
+        echo "::error::No permission was named. create-github-app-token requests every permission the installation holds when given none, so this refuses rather than mint that token."
+        exit 1
+
+    - name: Mint the token
+      id: mint
+      uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+      with:
+        client-id: ${{ inputs.client-id }}
+        private-key: ${{ inputs.private-key }}
+        owner: ${{ inputs.owner }}
+        repositories: ${{ inputs.repositories }}
+        permission-contents: ${{ inputs.permission-contents }}
+        permission-pull-requests: ${{ inputs.permission-pull-requests }}
+        permission-checks: ${{ inputs.permission-checks }}
+        permission-statuses: ${{ inputs.permission-statuses }}
diff --git a/.github/workflows/checkout/action.yml b/.github/workflows/checkout/action.yml
new file mode 100644
index 0000000..8f4e383
--- /dev/null
+++ b/.github/workflows/checkout/action.yml
@@ -0,0 +1,32 @@
+# The one place the actions/checkout commit is written.
+#
+# Most jobs reach this through $/.github/workflows/mobilize. A job that cannot
+# know what to fetch until it has run a few steps - the clerk resolves a pull
+# request number from a comment first - calls this directly, later.
+#
+# persist-credentials is not an input. No job here needs the token left on
+# disk, and leaving it lets any later step, or anything a later step runs, push
+# with the job's credentials - silently, because the checkout succeeds either
+# way. tests/go/repo/joblaw_test.go reads through this action to hold that.
+name: "Checkout"
+description: Check out the repository without leaving the job's token on disk.
+
+inputs:
+  fetch-depth:
+    description: How much history to check out; 0 is all of it.
+    required: false
+    default: "1"
+  ref:
+    description: What to check out; empty means the commit that triggered the run.
+    required: false
+    default: ""
+
+runs:
+  using: composite
+  steps:
+    - name: Check out the repository
+      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      with:
+        fetch-depth: ${{ inputs.fetch-depth }}
+        ref: ${{ inputs.ref }}
+        persist-credentials: false
