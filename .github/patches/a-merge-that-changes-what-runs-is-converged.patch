diff --git a/.github/workflows/codeql.yml b/.github/workflows/codeql.yml
index 3ad98e4..b20e1cb 100644
--- a/.github/workflows/codeql.yml
+++ b/.github/workflows/codeql.yml
@@ -38,6 +38,13 @@ on:
 
 permissions: read-all
 
+# A newer push to the same pull request replaces this run. A run on main is
+# keyed by its commit and is never replaced: each is the record for that
+# commit, and the weekly run has no pull request either.
+concurrency:
+  group: codeql-${{ github.event_name }}-${{ github.event.pull_request.number || github.sha }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
 # GitHub's default shell for `run:` is `bash -e {0}`, which has no
 # pipefail: in `a | b` only b's exit status counts, so a failing command
 # feeding a working one is a green step. Naming the shell explicitly gets
diff --git a/.github/workflows/dependency-review.yml b/.github/workflows/dependency-review.yml
index eae8ea1..b6d610b 100644
--- a/.github/workflows/dependency-review.yml
+++ b/.github/workflows/dependency-review.yml
@@ -12,6 +12,13 @@ on: [pull_request]
 permissions:
   contents: read
 
+# A newer push to the same pull request replaces this run. It reads the
+# pull request as it now is, and an answer about a commit that has been
+# pushed over is an answer nobody will read.
+concurrency:
+  group: dependency-review-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
 # GitHub's default shell for `run:` is `bash -e {0}`, which has no
 # pipefail: in `a | b` only b's exit status counts, so a failing command
 # feeding a working one is a green step. Naming the shell explicitly gets
diff --git a/.github/workflows/deploy-infrastructure.yml b/.github/workflows/deploy-infrastructure.yml
index 490c03e..9361e39 100644
--- a/.github/workflows/deploy-infrastructure.yml
+++ b/.github/workflows/deploy-infrastructure.yml
@@ -32,6 +32,14 @@ on:
       - "config/management.tpl.json"
       - "environments/**/infrastructure/**"
       - "modules/infrastructure/**"
+      # What Flux deploys. A merge here changes what runs on a site with no
+      # help from a converge, and that was the trouble: nothing took a record
+      # afterwards, so the site's capacity - what a pull request's change is
+      # held against - stayed as it was before the merge, and a second
+      # change was judged against room the first had already taken. A
+      # converge here applies nothing of its own. It waits for Flux to
+      # settle and takes the record, which is the point.
+      - "clusters/**"
 
 permissions:
   contents: read
@@ -151,7 +159,9 @@ jobs:
           # its first match can fail the writer with SIGPIPE and turn a match
           # into a miss.
           site_files="$(grep -vE '^management/estate/' <<<"${files}" || true)"
-          grep -qE '^(management/|config/management\.tpl\.json$)' <<<"${site_files}" && mgmt=true
+          # clusters/ is here for the record a converge ends with, not for
+          # anything it applies: see the trigger's paths above.
+          grep -qE '^(management/|clusters/|config/management\.tpl\.json$)' <<<"${site_files}" && mgmt=true
           # The same paths the trigger filters on, not a broader guess at them.
           # This used to match any file under environments/ or modules/, so a
           # change to an application module - the game server's Deployment -
diff --git a/.github/workflows/plan-infrastructure.yml b/.github/workflows/plan-infrastructure.yml
index 6b5d986..3a61093 100644
--- a/.github/workflows/plan-infrastructure.yml
+++ b/.github/workflows/plan-infrastructure.yml
@@ -21,6 +21,12 @@ on:
       - "modules/infrastructure/**"
       - "management/**"
       - "config/management.tpl.json"
+      # What Flux deploys, and the applications it deploys from. A change
+      # here plans as no change to any root, and is planned all the same:
+      # the plan is where a change is held to what the site can hold, and
+      # these are the changes that add to it.
+      - "clusters/**"
+      - "modules/applications/**"
 
 permissions:
   contents: read
