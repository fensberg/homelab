 name: Sensitive Paths
 
+# The acknowledgement is a review conversation, not a label.
+#
+# It used to be a label, and the label outlived the diff it acknowledged.
+# GitHub dismisses stale reviews when a branch moves and never touches labels,
+# so `sensitive-reviewed` survived every later commit: touch a sensitive path,
+# read the comment, apply the label, push a fixup, merge. The gate was
+# satisfied for a diff nobody had looked at, and a fixup is exactly where a
+# deleted assertion hides.
+#
+# A conversation fixes that by construction rather than by a rule bolted on
+# top. It is anchored to the file in the diff, so resolving it means somebody
+# was in the change rather than clicking a checkbox on the side of the page. It
+# is keyed to a digest of the sensitive part of the diff, so changing that part
+# opens a new one and leaves the old acknowledgement behind. And GitHub's own
+# "require conversation resolution before merging" enforces it, which is one
+# fewer thing for this workflow to be the only guarantee of.
+#
+# What is left for this workflow to check is the one thing GitHub will not:
+# **who** resolved it. An acknowledgement closed by whoever opened the pull
+# request is not an acknowledgement. That check should never fire.
 on:
   pull_request:
-    types: [opened, synchronize, reopened, labeled, unlabeled]
+    types: [opened, synchronize, reopened]
+  # Resolution emits no `pull_request` event, so without this the check would
+  # be evaluated against a thread that was unresolved when it ran and stay red
+  # after somebody resolved it - a deadlock rather than a gate.
+  pull_request_review_thread:
+    types: [resolved, unresolved]
 
 permissions:
   contents: read
