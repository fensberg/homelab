diff --git a/.github/workflows/expediter.yml b/.github/workflows/expediter.yml
new file mode 100644
index 0000000..c0133fa
--- /dev/null
+++ b/.github/workflows/expediter.yml
@@ -0,0 +1,349 @@
+name: "Expediter"
+
+# The expediter: image update automation for the game server.
+#
+# On a construction site the expediter chases orders with suppliers and gets
+# material to site when it is needed. They do not build or install anything.
+# This does the same for one item from one approved supplier: when Valve
+# publishes a new build of the Valheim dedicated server, it takes delivery -
+# builds the image, pins the digest - and submits it.
+#
+# WHY IT EXISTS. Valheim clients update themselves through Steam and refuse a
+# server on an older build, so every game patch strands every player until the
+# server is rebuilt. Before this, that meant a person dispatching a build,
+# copying a digest out of a log, editing a manifest, opening, merging and
+# tagging - six steps, none of them a decision, and each one a way to get it
+# wrong (the log prints the local image id right beside the manifest digest).
+# The version itself is deliberately not pinned in the Dockerfile, for the
+# reason it gives there; this is what makes that affordable.
+#
+# WHAT IT MAY DO, AND WHAT KEEPS IT THERE.
+#
+#   check-deliveries  ask Steam for the public build; compare it with the one
+#                     recorded beside the pinned digest
+#   take-delivery     build the image for exactly that build, open a pull
+#                     request changing the digest and the recorded build
+#   (merge, release)  once every required check passes, merge under its
+#                     standing order and tag the release
+#
+# The standing order is the expediter's GitHub App being a bypass actor on the
+# ruleset that requires a review - and only that one. The ruleset requiring
+# checks has no bypass, so its pull request must pass all of them, including
+# `security guard-standing-order` in the Sensitive Paths lane, which refuses any
+# pull request by the expediter that changes anything but those two lines or
+# points the digest at a different image repository. The review is skipped; the
+# checks are not.
+#
+# Without the bypass the merge is refused and the pull request waits for a
+# review, which is the same machinery with a person at the end. Without the
+# EXPEDITER_LOGIN variable it does not attempt the merge at all, so the bypass
+# is never used while the check that bounds it is unarmed.
+#
+# Configuration, all on the repository rather than in this file so a fork
+# brings its own:
+#
+#   vars.EXPEDITER_CLIENT_ID     the GitHub App's client ID
+#   vars.EXPEDITER_LOGIN         its bot login, e.g. <app-slug>[bot]
+#   secrets.EXPEDITER_PRIVATE_KEY  its private key
+
+on:
+  schedule:
+    # Requested every fifteen minutes. GitHub's scheduler delays and drops
+    # scheduled runs under load - the security patrol sees gaps of four to five
+    # hours - so treat this as "within a few hours" rather than fifteen
+    # minutes, and dispatch it by hand when a patch has just landed.
+    - cron: "*/15 * * * *"
+  workflow_dispatch:
+    inputs:
+      force:
+        description: "Take a delivery even if Steam's build is unchanged (after a Dockerfile change)"
+        type: boolean
+        default: false
+
+permissions:
+  contents: read
+
+# One at a time. Two runs taking the same delivery would open the same pull
+# request twice and race each other to tag it.
+concurrency:
+  group: expediter
+  cancel-in-progress: false
+
+defaults:
+  run:
+    shell: bash
+
+jobs:
+  deliver:
+    name: "Check deliveries, take delivery"
+    runs-on: ubuntu-latest
+    # Bounded so a stuck run cannot bill forever. The longest honest path is a
+    # 2 GB download, a build, and a full set of required checks.
+    timeout-minutes: 75
+    permissions:
+      contents: read
+      packages: write
+    env:
+      PIN: modules/applications/valheim/base/deployment.yaml
+      APP_ID: "896660"
+      REPO: ${{ github.repository }}
+      IMAGE: ghcr.io/${{ github.repository }}-valheim
+    steps:
+      # Audit, not block, and this is why: SteamCMD reaches Valve's content
+      # servers, which are a changing set of hosts - approved-suppliers.yml
+      # records that Valve moves them - so an allowlist would break on Valve's
+      # schedule rather than this estate's. The same reasoning, and the same
+      # setting, as the image build this replaces.
+      - name: Harden Runner
+        uses: step-security/harden-runner@e14015d583714f6e62063499dc959a02595150a1 # v2.21.1
+        with:
+          egress-policy: audit
+
+      - name: Checkout Code
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Check deliveries
+        id: check
+        env:
+          FORCE: ${{ inputs.force }}
+        run: |
+          set -euo pipefail
+
+          # SteamCMD is a 32-bit binary, the same reason the Dockerfile
+          # installs this library.
+          sudo apt-get update -qq
+          sudo apt-get install -y -qq lib32gcc-s1 >/dev/null
+
+          steam="$RUNNER_TEMP/steamcmd"
+          mkdir -p "$steam"
+          curl -fsSL -o "$steam/steamcmd.tar.gz" https://media.steampowered.com/client/steamcmd_linux.tar.gz
+          tar -xzf "$steam/steamcmd.tar.gz" -C "$steam"
+          # It updates itself on first run and a request in that same run can
+          # fail; the Dockerfile learned the same thing.
+          "$steam/steamcmd.sh" +quit >/dev/null 2>&1 || true
+
+          build=""
+          for attempt in 1 2 3; do
+            info="$("$steam/steamcmd.sh" +login anonymous +app_info_update 1 +app_info_print "$APP_ID" +quit || true)"
+            build="$(awk '/"branches"/ {b=1} b && /"public"/ {p=1} p && /"buildid"/ {gsub(/[^0-9]/, ""); print; exit}' <<<"$info")"
+            [ -n "$build" ] && break
+            echo "attempt ${attempt}: Steam did not report a public build; retrying" >&2
+            sleep 15
+          done
+          if [ -z "$build" ]; then
+            echo "::error::Steam reported no public build for app ${APP_ID}, so there is nothing to compare"
+            exit 1
+          fi
+
+          recorded="$(sed -n 's/^[[:space:]]*[a-z0-9.-]*\/steam-build:[[:space:]]*"\([^"]*\)".*/\1/p' "$PIN" | head -n 1)"
+          echo "Steam's public build: ${build}; recorded beside the pin: ${recorded:-nothing}"
+
+          if [ "$build" = "$recorded" ] && [ "${FORCE}" != "true" ]; then
+            echo "no delivery: the server already runs build ${build}" >> "$GITHUB_STEP_SUMMARY"
+            echo "deliver=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          echo "delivery: Steam build ${build}, replacing ${recorded:-nothing}" >> "$GITHUB_STEP_SUMMARY"
+          echo "deliver=true" >> "$GITHUB_OUTPUT"
+          echo "build=${build}" >> "$GITHUB_OUTPUT"
+          echo "recorded=${recorded}" >> "$GITHUB_OUTPUT"
+
+      - name: Take delivery
+        id: image
+        if: steps.check.outputs.deliver == 'true'
+        env:
+          TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          ACTOR: ${{ github.actor }}
+          BUILD: ${{ steps.check.outputs.build }}
+        run: |
+          set -euo pipefail
+          echo "$TOKEN" | docker login ghcr.io -u "$ACTOR" --password-stdin
+
+          # The build argument makes the image refuse to build if Steam serves
+          # anything but this build, so the label - and the record in git - is
+          # true of what is inside.
+          docker build \
+            --build-arg VALHEIM_BUILDID="$BUILD" \
+            -t "${IMAGE}:steam-${BUILD}" \
+            modules/applications/valheim/image
+          docker push "${IMAGE}:steam-${BUILD}"
+
+          # The manifest digest from the registry, not the local image id -
+          # the two sit side by side in a build log and are not the same thing.
+          digest="$(docker inspect --format='{{index .RepoDigests 0}}' "${IMAGE}:steam-${BUILD}")"
+          digest="${digest#*@}"
+          case "$digest" in
+            sha256:*) ;;
+            *) echo "::error::the registry gave no manifest digest for ${IMAGE}:steam-${BUILD}"; exit 1 ;;
+          esac
+          echo "digest=${digest}" >> "$GITHUB_OUTPUT"
+          echo "built ${IMAGE}@${digest}" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Mint the expediter's token
+        id: token
+        if: steps.check.outputs.deliver == 'true'
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        with:
+          client-id: ${{ vars.EXPEDITER_CLIENT_ID }}
+          private-key: ${{ secrets.EXPEDITER_PRIVATE_KEY }}
+          # This repository only - the token cannot reach anything else the
+          # App happens to be installed on.
+          owner: ${{ github.repository_owner }}
+          repositories: ${{ github.event.repository.name }}
+
+      # Through the API rather than git push. A commit created there is signed
+      # by GitHub on the App's behalf, which the ruleset requiring signatures on
+      # every branch accepts; a push from this runner would be unsigned and
+      # refused - the same reasoning scripts/signedpush documents.
+      - name: Submit it
+        id: submit
+        if: steps.check.outputs.deliver == 'true'
+        env:
+          GH_TOKEN: ${{ steps.token.outputs.token }}
+          BUILD: ${{ steps.check.outputs.build }}
+          RECORDED: ${{ steps.check.outputs.recorded }}
+          DIGEST: ${{ steps.image.outputs.digest }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          set -euo pipefail
+          branch="expediter/valheim-steam-${BUILD}"
+
+          # A delivery already submitted is picked up again, not submitted
+          # twice - a run that timed out waiting for checks left it open.
+          pr="$(gh pr list --repo "$REPO" --head "$branch" --state open --json number --jq '.[0].number // empty')"
+          if [ -n "$pr" ]; then
+            echo "pull request #${pr} already carries this delivery"
+            echo "pr=${pr}" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+
+          # Edit main as it is now, not the checkout: main can have moved since
+          # this run started, and the commit's parent is main.
+          base="$(gh api "repos/${REPO}/git/ref/heads/main" --jq .object.sha)"
+          base_tree="$(gh api "repos/${REPO}/git/commits/${base}" --jq .tree.sha)"
+          gh api "repos/${REPO}/contents/${PIN}?ref=${base}" --jq .content | base64 -d > "$RUNNER_TEMP/pin.yaml"
+
+          sed -i -E "s#(image:[[:space:]]+[^@[:space:]]+@)sha256:[0-9a-f]{64}#\1${DIGEST}#" "$RUNNER_TEMP/pin.yaml"
+          sed -i -E "s#([a-z0-9.-]+/steam-build:[[:space:]]+)\"[^\"]*\"#\1\"${BUILD}\"#" "$RUNNER_TEMP/pin.yaml"
+          if ! grep -q "@${DIGEST}" "$RUNNER_TEMP/pin.yaml" || ! grep -q "steam-build: \"${BUILD}\"" "$RUNNER_TEMP/pin.yaml"; then
+            echo "::error::could not find the pinned image and the steam-build annotation in ${PIN}; its shape has changed and this needs updating"
+            exit 1
+          fi
+
+          blob="$(gh api "repos/${REPO}/git/blobs" -f content="$(base64 -w0 "$RUNNER_TEMP/pin.yaml")" -f encoding=base64 --jq .sha)"
+          tree="$(gh api "repos/${REPO}/git/trees" \
+            -f base_tree="$base_tree" \
+            -f "tree[][path]=${PIN}" \
+            -f "tree[][mode]=100644" \
+            -f "tree[][type]=blob" \
+            -f "tree[][sha]=${blob}" \
+            --jq .sha)"
+          message="$(printf '%s\n' \
+            "feat: take delivery of Valheim server build ${BUILD}" \
+            "" \
+            "Valve published a new build of the dedicated server, and clients refuse" \
+            "a server on an older one. Pins the image built from it." \
+            "" \
+            "Image:  ${IMAGE}" \
+            "Digest: ${DIGEST}" \
+            "" \
+            "Taken by the expediter: ${RUN_URL}")"
+          # No author, committer or signature field: GitHub signs on the App's
+          # behalf and attributes the commit to it.
+          commit="$(gh api "repos/${REPO}/git/commits" -f message="$message" -f tree="$tree" -f "parents[]=${base}" --jq .sha)"
+          gh api "repos/${REPO}/git/refs" -f ref="refs/heads/${branch}" -f sha="$commit" >/dev/null
+
+          url="$(gh pr create --repo "$REPO" --base main --head "$branch" \
+            --title "feat: take delivery of Valheim server build ${BUILD}" \
+            --body "$(printf '%s\n' \
+              "## What this is" \
+              "" \
+              "Valve published build **${BUILD}** of the Valheim dedicated server. Players' clients update themselves and refuse a server on an older build, so this pins the image built from it." \
+              "" \
+              "| | |" \
+              "| --- | --- |" \
+              "| Steam build | \`${RECORDED:-unknown}\` → \`${BUILD}\` |" \
+              "| Image | \`${IMAGE}@${DIGEST}\` |" \
+              "" \
+              "## What happens next" \
+              "" \
+              "Every required check runs, including \`security guard-standing-order\`, which refuses this pull request if it changes anything but the digest and the recorded build. If they pass and the expediter holds its standing order, it merges this and tags the release. If it does not, this waits for a review." \
+              "" \
+              "Taken by the expediter: ${RUN_URL}")")"
+          pr="${url##*/}"
+          echo "opened #${pr}" >> "$GITHUB_STEP_SUMMARY"
+          echo "pr=${pr}" >> "$GITHUB_OUTPUT"
+
+      - name: Wait for every required check
+        if: steps.check.outputs.deliver == 'true'
+        env:
+          GH_TOKEN: ${{ steps.token.outputs.token }}
+          PR: ${{ steps.submit.outputs.pr }}
+        run: |
+          set -euo pipefail
+          # Checks register a few seconds after the pull request opens, and
+          # asking before then is answered "no checks reported".
+          # gh answers 0 when every check has passed and 8 while any is still
+          # pending; either means they are registered.
+          for _ in $(seq 1 20); do
+            rc=0
+            gh pr checks "$PR" --repo "$REPO" --required >/dev/null 2>&1 || rc=$?
+            if [ "$rc" -eq 0 ] || [ "$rc" -eq 8 ]; then break; fi
+            sleep 15
+          done
+          if ! timeout 50m gh pr checks "$PR" --repo "$REPO" --required --watch --interval 30 --fail-fast; then
+            gh pr comment "$PR" --repo "$REPO" --body "A required check did not pass, so the expediter is leaving this for a person. If it was the Super-Linter hang (#365), re-running that job is usually enough; merging is then an ordinary review."
+            exit 1
+          fi
+
+      - name: Merge under the standing order
+        id: merge
+        if: steps.check.outputs.deliver == 'true'
+        env:
+          GH_TOKEN: ${{ steps.token.outputs.token }}
+          PR: ${{ steps.submit.outputs.pr }}
+          BUILD: ${{ steps.check.outputs.build }}
+          HOLDER: ${{ vars.EXPEDITER_LOGIN }}
+        run: |
+          set -euo pipefail
+          # Armed only when the check that bounds the order is: with no
+          # EXPEDITER_LOGIN, guard-standing-order has nobody to hold to it, so
+          # nothing is merged under the bypass.
+          if [ -z "$HOLDER" ]; then
+            gh pr comment "$PR" --repo "$REPO" --body "Every required check passed. No standing order is configured (EXPEDITER_LOGIN is unset), so this waits for a review."
+            echo "merged=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          # An explicit message, kept inside commitlint's line limits, rather
+          # than whatever the repository's squash default assembles from the
+          # pull request body - which carries a table and long lines.
+          if ! gh pr merge "$PR" --repo "$REPO" --squash \
+            --subject "feat: take delivery of Valheim server build ${BUILD} (#${PR})" \
+            --body "Merged by the expediter under its standing order, after every required check passed."; then
+            gh pr comment "$PR" --repo "$REPO" --body "Every required check passed, but the merge was refused. The expediter is probably not a bypass actor on the review ruleset - without that this waits for a review, which is the fallback working as designed."
+            exit 1
+          fi
+          echo "merged=true" >> "$GITHUB_OUTPUT"
+
+      # Production reconciles from the highest v* tag, so a merged delivery
+      # changes nothing until it is tagged. The tag is the next patch version,
+      # on the merge commit.
+      - name: Release it
+        if: steps.merge.outputs.merged == 'true'
+        env:
+          GH_TOKEN: ${{ steps.token.outputs.token }}
+          PR: ${{ steps.submit.outputs.pr }}
+          BUILD: ${{ steps.check.outputs.build }}
+        run: |
+          set -euo pipefail
+          merged="$(gh pr view "$PR" --repo "$REPO" --json mergeCommit --jq .mergeCommit.oid)"
+          last="$(gh api "repos/${REPO}/git/matching-refs/tags/v" --paginate --jq '.[].ref' \
+            | sed 's#^refs/tags/##' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1)"
+          last="${last:-v0.0.0}"
+          IFS=. read -r major minor patch <<<"${last#v}"
+          next="v${major}.${minor}.$((patch + 1))"
+          gh api "repos/${REPO}/git/refs" -f ref="refs/tags/${next}" -f sha="$merged" >/dev/null
+          echo "released ${next}: Steam build ${BUILD}" >> "$GITHUB_STEP_SUMMARY"
+          gh pr comment "$PR" --repo "$REPO" --body "Released as \`${next}\`. Production reconciles from it within about a minute."
