diff --git a/.github/workflows/mobilize/action.yml b/.github/workflows/mobilize/action.yml
index af5ef34..bd039a3 100644
--- a/.github/workflows/mobilize/action.yml
+++ b/.github/workflows/mobilize/action.yml
@@ -62,6 +62,14 @@ inputs:
     required: false
     default: "1"
 
+outputs:
+  held:
+    description: >-
+      "true" where sudo was to be removed and is, "false" where it was to be
+      and is not, and nothing for a job that keeps it. For a lane that proves
+      the block, which has nothing to prove on a runner that is not held.
+    value: ${{ steps.held.outputs.held }}
+
 runs:
   using: composite
   steps:
@@ -97,7 +105,18 @@ runs:
     # Only where sudo was to be removed. A job that keeps it says why beside
     # its entry in scripts/approved-suppliers.yml, and a runner on the estate
     # is not hardened by this at all.
-    - name: This runner is held, or the job stops
+    # SAID, AND NOT YET STOPPED FOR. This stopped the job, and about one of
+    # GitHub's runners in eight is not held (#725), so most runs had a job
+    # stopped and nothing could be merged without running jobs again -
+    # the changes that move these jobs onto the estate's own runners among
+    # them (#559). The operator loosened it for as long as that takes: a
+    # runner that is not held is said, loudly and with why, and the job
+    # goes on as it did before anything looked. It is not safer than it
+    # was; it is no longer silent. When a pull request's jobs run on the
+    # estate's runners this step has nothing left to look at there, and
+    # for whatever still runs on GitHub's it goes back to stopping.
+    - name: Whether this runner is held
+      id: held
       if: inputs.disable-sudo-and-containers == 'true'
       shell: bash
       run: |
@@ -130,8 +149,10 @@ runs:
           sudo systemctl status agent --no-pager 2>&1 | head -20 || true
           sudo journalctl -u agent --no-pager -n 40 2>&1 || true
           echo "::endgroup::"
-          echo "::error::sudo still works on this runner after it was to be removed, so what hardens the runner did not start here: nothing blocks what this job reaches, and a later step could switch enforcement off. Run the job again; it gets another runner."
-          exit 1
+          echo "::warning::THIS JOB RAN WITH NOTHING HELD. Sudo still works on this runner after it was to be removed, so what hardens the runner did not start here: nothing blocked what this job reached. The cause is known (#725) and the job was let go on by the operator's decision, until pull requests run on the estate's own runners (#559)."
+          echo "held=false" >>"$GITHUB_OUTPUT"
+        else
+          echo "held=true" >>"$GITHUB_OUTPUT"
         fi
 
     - name: Refuse an unrecognised value
diff --git a/.github/workflows/pr-validation.yml b/.github/workflows/pr-validation.yml
index 1c19521..bf40c6d 100644
--- a/.github/workflows/pr-validation.yml
+++ b/.github/workflows/pr-validation.yml
@@ -1494,6 +1494,7 @@ jobs:
       ALLOWED: https://github.com
     steps:
       - name: Mobilize
+        id: mobilize
         uses: $/.github/workflows/mobilize
         with:
           # Owned by scripts/approved-suppliers.yml under `egress:`, which says
@@ -1514,7 +1515,19 @@ jobs:
       # The protection that makes a block stay a block. With sudo, any later
       # step in a job can stop harden-runner's agent or flush its rules and
       # then call out (#410).
+      # Nothing to prove on a runner that is not held. About one of GitHub's
+      # in eight is not (#725), mobilize says so, and this lane's three
+      # proofs would each fail there for that one reason and not for
+      # anything a pull request did. So they are asked of a runner that is
+      # held, and one that is not says it proved nothing. Loosened with the
+      # check in mobilize, and for as long.
+      - name: Nothing is proved on a runner that is not held
+        if: steps.mobilize.outputs.held != 'true'
+        run: |
+          echo "::warning::The egress proof proved nothing on this run: its runner was not held (#725)."
+
       - name: Sudo is gone
+        if: steps.mobilize.outputs.held == 'true'
         run: |
           if sudo -n true 2>/dev/null; then
             echo "::error::sudo still works after mobilize with disable-sudo-and-containers: \"true\". Any step in a blocking job could switch egress enforcement off."
@@ -1523,6 +1536,7 @@ jobs:
           echo "sudo is refused, so no later step can dismantle enforcement."
 
       - name: An allowed host answers
+        if: steps.mobilize.outputs.held == 'true'
         run: |
           if ! curl --silent --show-error --max-time 20 --output /dev/null "$ALLOWED"; then
             echo "::error::$ALLOWED is on this job's allowlist and did not answer. The block is refusing everything, so a refused probe below would not show that it refuses selectively."
@@ -1530,6 +1544,7 @@ jobs:
           fi
 
       - name: The probe host is refused
+        if: steps.mobilize.outputs.held == 'true'
         run: |
           if curl --silent --show-error --max-time 20 --output /dev/null "$PROBE"; then
             echo "::error::$PROBE answered under egress-policy: block through mobilize. harden-runner's policy was not installed, so every job in this repository is unwatched while reporting green."
