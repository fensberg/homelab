diff --git a/.github/workflows/clerk.yml b/.github/workflows/clerk.yml
index f5d0e31..aa03cf5 100644
--- a/.github/workflows/clerk.yml
+++ b/.github/workflows/clerk.yml
@@ -239,7 +239,14 @@ jobs:
         if: steps.touched.outputs.paths != '' && contains(steps.ask.outputs.verbs, 'snag')
         env:
           CLERK_BOT_LLM_KEY: ${{ secrets.CLERK_BOT_LLM_KEY }}
-          CLERK_BOT_APP_ID: ${{ secrets.CLERK_BOT_APP_ID }}
+          # The App's ID from a variable where one exists, falling back to the
+          # secret it has always been. An App ID is not a secret - GitHub
+          # documents it as a variable and the expediter stores it that way -
+          # and the two conventions disagreeing is what #382 is about. The
+          # fallback is what makes converging cost nobody an action: nothing
+          # breaks if the variable is never created.
+          CLERK_BOT_APP_ID: ${{ vars.CLERK_BOT_APP_ID || secrets.CLERK_BOT_APP_ID }}
+          # The .pem as GitHub generated it, or base64 of it. Both parse.
           CLERK_BOT_PRIVATE_KEY: ${{ secrets.CLERK_BOT_PRIVATE_KEY }}
           GITHUB_REPOSITORY: ${{ github.repository }}
           PR: ${{ steps.change.outputs.pr }}
@@ -305,7 +312,14 @@ jobs:
       - name: Say what the run found
         if: always() && steps.touched.outputs.paths != ''
         env:
-          CLERK_BOT_APP_ID: ${{ secrets.CLERK_BOT_APP_ID }}
+          # The App's ID from a variable where one exists, falling back to the
+          # secret it has always been. An App ID is not a secret - GitHub
+          # documents it as a variable and the expediter stores it that way -
+          # and the two conventions disagreeing is what #382 is about. The
+          # fallback is what makes converging cost nobody an action: nothing
+          # breaks if the variable is never created.
+          CLERK_BOT_APP_ID: ${{ vars.CLERK_BOT_APP_ID || secrets.CLERK_BOT_APP_ID }}
+          # The .pem as GitHub generated it, or base64 of it. Both parse.
           CLERK_BOT_PRIVATE_KEY: ${{ secrets.CLERK_BOT_PRIVATE_KEY }}
           GITHUB_REPOSITORY: ${{ github.repository }}
           PR: ${{ steps.change.outputs.pr }}
diff --git a/.github/workflows/expediter.yml b/.github/workflows/expediter.yml
index 8579c5e..c085b38 100644
--- a/.github/workflows/expediter.yml
+++ b/.github/workflows/expediter.yml
@@ -60,8 +60,16 @@ name: "Expediter"
 #   secrets.EXPEDITER_BOT_APP_ID       the GitHub App's ID or client ID - the
 #                                      token action accepts either
 #   secrets.EXPEDITER_BOT_PRIVATE_KEY  its private key, the .pem exactly as
-#                                      GitHub generated it. NOT base64, which
-#                                      is what the clerk's key wants (#382)
+#                                      GitHub generated it, newlines and all.
+#                                      actions/create-github-app-token cannot
+#                                      parse base64.
+#
+# That is now the ONE convention both Apps here use. The clerk used to insist
+# on base64 of the PEM, so whoever set this App up copied the App that already
+# existed and put base64 where the action wanted a PEM - failing at the token
+# step with a message pointing at neither (#382). scripts/clerk/github.go
+# accepts both shapes now, so the raw PEM below is correct for both and
+# copying either App's setup works.
 #   vars.EXPEDITER_LOGIN               its bot login, e.g. <app-slug>[bot]
 
 on:
