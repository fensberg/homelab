-name: Duty
-
-# Says, once, that a scheduled workflow is failing, and says it has stopped.
-#
-# A scheduled run's failure notifies only whoever last edited its cron, by
-# email, and nobody acted on it: the expediter failed daily for a week and the
-# nightly for four nights before anyone knew (#441). This workflow watches every
-# scheduled one finish, and keeps one issue per workflow open while it fails.
-#
-# One workflow for all of them, rather than a `report` job in each. That job
-# was skipped on every run that was not scheduled - a pull request's CodeQL run
-# showed a skipped Report among its checks, which is noise a reviewer has to
-# learn to ignore - and it was one more copy of the same thing per workflow.
-# tests/go/repo/duty_report_test.go holds this list to the scheduled workflows
-# in both directions, so a new schedule cannot start without being watched.
-#
-# workflow_run runs this file as it is on the default branch, with the default
-# branch's token, whatever triggered the run it watches. That is the reason
-# zizmor calls the trigger dangerous: code from a pull request reaching a
-# privileged context. Nothing here takes anything from the watched run but its
-# name, conclusion, event and address - no checkout, no artifact, no head
-# branch - and the job can do one thing, which is write issues.
-on:
-  # proved by TestAWorkflowStartedByAnotherTakesNothingFromItButItsOutcome
-  workflow_run: # zizmor: ignore[dangerous-triggers]
-    workflows:
-      - CodeQL
-      - Expedite
-      - Integration Tests
-      - Scorecard
-      - Security Patrol
-      - Site Sweep
-    types: [completed]
-
-permissions:
-  contents: read
-
-# One report at a time per watched workflow, in order, so an older run's
-# verdict cannot land after a newer one's.
-concurrency:
-  group: duty-${{ github.event.workflow_run.name }}
-  cancel-in-progress: false
-
-defaults:
-  run:
-    shell: bash
-
-jobs:
-  report:
-    name: Report
-    # Only a scheduled run, and only a verdict: a dispatched run has somebody
-    # watching it, and a cancelled or skipped one says nothing about whether
-    # the schedule is healthy - it must neither open nor close the issue.
-    if: >-
-      github.event.workflow_run.event == 'schedule' &&
-      contains(fromJSON('["success","failure","timed_out","startup_failure"]'), github.event.workflow_run.conclusion)
-    runs-on: ubuntu-latest
-    permissions:
-      issues: write
-    timeout-minutes: 5
-    steps:
-      - name: Mobilize
-        uses: $/.github/workflows/mobilize
-        with:
-          # Owned by scripts/approved-suppliers.yml under `egress:`, which says
-          # which job may reach what; `security guard-egress` refuses any drift.
-          # The copy lives here because harden-runner reads its policy in a
-          # pre-step, before any step of this job can run.
-          egress-policy: block
-          disable-sudo-and-containers: "true"
-          allowed-endpoints: >
-            api.github.com:443
-          checkout: "false"
-
-      - name: Say whether this schedule is failing
-        uses: $/.github/workflows/github-script
-        env:
-          WORKFLOW: ${{ github.event.workflow_run.name }}
-          FAILED: ${{ github.event.workflow_run.conclusion != 'success' }}
-          RUN_URL: ${{ github.event.workflow_run.html_url }}
-        with:
-          name: duty-report
