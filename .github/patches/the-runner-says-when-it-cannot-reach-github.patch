diff --git a/.github/workflows/mobilize/action.yml b/.github/workflows/mobilize/action.yml
index bd039a3..87f3de7 100644
--- a/.github/workflows/mobilize/action.yml
+++ b/.github/workflows/mobilize/action.yml
@@ -155,6 +155,39 @@ runs:
           echo "held=true" >>"$GITHUB_OUTPUT"
         fi
 
+    - name: Whether this runner reaches what it is allowed
+      # The agent allows an address only when it has seen the name resolve
+      # through its own resolver. On some runners it holds the runner and the
+      # lookups go around it anyway, so it refuses every name - github.com,
+      # which every job's allowlist names, among them - and the job fails
+      # three fetches into its checkout on "exit code 128", which names
+      # neither (#791). Why the lookups go around it is not known. So this
+      # asks the way the checkout will, and where it is refused, says so,
+      # prints what the next such runner needs to show for the cause to be
+      # found, and stops. Nothing is tried again: a job cannot move itself
+      # to another runner, and the cause is not this job's to repair.
+      if: inputs.egress-policy == 'block'
+      shell: bash
+      run: |
+        said="$RUNNER_TEMP/reach-github"
+        if curl -sS -o /dev/null --max-time 15 https://github.com/ 2>"$said"; then
+          exit 0
+        fi
+        # Readable without sudo, which the agent has removed by now. The
+        # agent's own log is printed by its post step, at the end of the job.
+        echo "::group::What the runner said"
+        cat "$said" || true
+        echo "::endgroup::"
+        echo "::group::How the runner resolves"
+        getent ahosts github.com || true
+        resolvectl status --no-pager || true
+        resolvectl statistics --no-pager || true
+        echo "--- /etc/resolv.conf"
+        cat /etc/resolv.conf || true
+        echo "::endgroup::"
+        echo "::error::This runner cannot reach github.com, which this job is allowed to: the hardening agent holds the runner and its lookups go around the agent, so every name is refused (#791). Nothing in the change being tested caused this."
+        exit 1
+
     - name: Refuse an unrecognised value
       if: >-
         (inputs.checkout != 'true' && inputs.checkout != 'false') ||
