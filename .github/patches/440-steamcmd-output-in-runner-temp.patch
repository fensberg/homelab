@@ -64,8 +64,19 @@ name: "Expedite"
 # Configuration, all on the repository rather than in this file so a fork
 # brings its own:
 #
-#   secrets.EXPEDITE_BOT_APP_ID        the GitHub App's ID or client ID - the
-#                                      token action accepts either
+#   secrets.EXPEDITE_BOT_CLIENT_ID     the GitHub App's Client ID, the one
+#                                      beginning "Iv", from the App's
+#                                      settings page. It is passed as
+#                                      `client-id`, which the pinned token
+#                                      action documents as "GitHub App Client
+#                                      ID"; its numeric `app-id` input is
+#                                      separate. This was EXPEDITE_BOT_APP_ID,
+#                                      a name for a different value, and
+#                                      every delivery from 12 September failed
+#                                      minting a token with "Integration not
+#                                      found" (#439). The name now says what
+#                                      the value is, and a guard holds every
+#                                      token input to that.
 #   secrets.EXPEDITE_BOT_PRIVATE_KEY   its private key, the .pem exactly as
 #                                      GitHub generated it, newlines and all.
 #                                      actions/create-github-app-token cannot
@@ -241,19 +252,17 @@ jobs:
           # cannot quietly start retrying a check. steamcmd is on that list
           # because Valve's app_info lookup reports no public build under load,
           # which has nothing to do with the change being tested.
-          # +app_info_request before +app_info_print (#440). SteamCMD answers
-          # a print from its local cache, and a cache with nothing in it prints
-          # no branches at all - which the parser below reads as "no public
-          # build". Requesting first asks Steam rather than the cache.
-          #
-          # That is the likely cause of every failure since 17 September, and
-          # it is not a proven one: the step used to throw away SteamCMD's
-          # output, so nothing recorded what it actually said. The output is
-          # printed on failure now, and the next run confirms or refutes this.
+          # $RUNNER_TEMP, never $TMPDIR (#440). GitHub-hosted runners do not
+          # set TMPDIR, and under `set -u` the redirect below failed with
+          # "TMPDIR: unbound variable" - so SteamCMD never ran, the parser read
+          # nothing, and every pass from 17 September reported "no public
+          # build". It arrived with #400 on 16 September. Printing the output
+          # on failure is what found it, on its first run; the guess made
+          # before that evidence existed was wrong, and is not carried here.
           info=""
           if scripts/retry.sh 3 15 "$steam/steamcmd.sh" +login anonymous \
-            +app_info_update 1 +app_info_request "$APP_ID" +app_info_print "$APP_ID" +quit >"$TMPDIR/steam.out" 2>&1; then
-            info="$(cat "$TMPDIR/steam.out")"
+            +app_info_update 1 +app_info_print "$APP_ID" +quit >"$RUNNER_TEMP/steam.out" 2>&1; then
+            info="$(cat "$RUNNER_TEMP/steam.out")"
           fi
           build="$(awk '/"branches"/ {b=1} b && /"public"/ {p=1} p && /"buildid"/ {gsub(/[^0-9]/, ""); print; exit}' <<<"$info")"
           if [ -z "$build" ]; then
