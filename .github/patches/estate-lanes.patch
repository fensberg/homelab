diff --git a/.github/workflows/deploy-infrastructure.yml b/.github/workflows/deploy-infrastructure.yml
index 7b908f7..dc88ba8 100644
--- a/.github/workflows/deploy-infrastructure.yml
+++ b/.github/workflows/deploy-infrastructure.yml
@@ -150,7 +150,13 @@ jobs:
 
           echo "changed files:"; echo "${files}"
           mgmt=false; work=false
-          grep -qE '^(management/|config/management\.tpl\.json$)' <<<"${files}" && mgmt=true
+          # The estate's root is the lawyer's, and converging a site does not
+          # touch it, so a change only there is no site's work. Filtered into
+          # a variable rather than piped: under pipefail, grep -q exiting at
+          # its first match can fail the writer with SIGPIPE and turn a match
+          # into a miss.
+          site_files="$(grep -vE '^management/estate/' <<<"${files}" || true)"
+          grep -qE '^(management/|config/management\.tpl\.json$)' <<<"${site_files}" && mgmt=true
           # The same paths the trigger filters on, not a broader guess at them.
           # This used to match any file under environments/ or modules/, so a
           # change to an application module - the game server's Deployment -
diff --git a/.github/workflows/pr-validation.yml b/.github/workflows/pr-validation.yml
index 7a70aed..e07810b 100644
--- a/.github/workflows/pr-validation.yml
+++ b/.github/workflows/pr-validation.yml
@@ -335,6 +335,16 @@ jobs:
           tofu init -backend=false -input=false
           tofu validate
 
+      # The estate's root reads none of a site's config, so it is validated
+      # against its own test fixture rather than the placeholder above.
+      - name: Validate OpenTofu (estate)
+        working-directory: management/estate
+        env:
+          TF_VAR_config_path: ./tests/fixtures/valid.json
+        run: |
+          tofu init -backend=false -input=false
+          tofu validate
+
       # `tofu test` used to run here. It moved to the Test lane below, along
       # with `go test`: this lane answers "does it resolve", that one answers
       # "does it behave", and one owner per check is the rule everywhere else
@@ -569,6 +579,14 @@ jobs:
           tofu init -backend=false -input=false
           tofu test
 
+      # The estate's root against a mocked Cloudflare, so no credential is
+      # needed: who may enroll, and that the split tunnel carries every route.
+      - name: Invariant tests (OpenTofu, estate)
+        working-directory: management/estate
+        run: |
+          tofu init -backend=false -input=false
+          tofu test
+
   vet:
     name: "Vet (every tier)"
     runs-on: ubuntu-latest
