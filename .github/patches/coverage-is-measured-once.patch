diff --git a/tests/mutations/TestHeavyGuardsRunOnEveryPullRequest.an-own-lane-guard-run-nowhere.yml b/tests/mutations/TestHeavyGuardsRunOnEveryPullRequest.an-own-lane-guard-run-nowhere.yml
new file mode 100644
index 00000000..0a6d2eab
--- /dev/null
+++ b/tests/mutations/TestHeavyGuardsRunOnEveryPullRequest.an-own-lane-guard-run-nowhere.yml
@@ -0,0 +1,8 @@
+guard: TestHeavyGuardsRunOnEveryPullRequest
+file: .github/workflows/pr-validation.yml
+find: 'run: go test ./repo/ -run "$OWN_LANE_TESTS"'
+replace: 'run: go test ./repo/ -run "^TestSomethingElse$"'
+mentions: "skips $OWN_LANE_TESTS in the full run of tests/go and no lane runs them"
+why: >
+  A guard the invariants lane leaves to a lane of its own runs nowhere if
+  that lane stops selecting it, and a skipped guard is a green one.
