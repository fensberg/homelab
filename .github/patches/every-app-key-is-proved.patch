diff --git a/.github/workflows/security-patrol.yml b/.github/workflows/security-patrol.yml
index 775ac5d..e2afcd3 100644
--- a/.github/workflows/security-patrol.yml
+++ b/.github/workflows/security-patrol.yml
@@ -111,3 +111,73 @@ jobs:
         run: |
           go build -C scripts/security -o ../../toolshed/security .
           ./toolshed/security patrol | tee "$GITHUB_STEP_SUMMARY"
+
+  # ---------------------------------------------------------------------
+  # EVERY APP KEY STILL MINTS A TOKEN (#527).
+  #
+  # An App's key is used only when there is something to do with it, so one
+  # that has stopped working is found on the day it is needed. Procurement's
+  # sat unparseable for an unknown time, every run in between green because
+  # none had a delivery to make, and it surfaced the morning a game update
+  # had locked players out.
+  #
+  # So each key is used here, every patrol, the way its own consumer uses it,
+  # and the token is thrown away: the action for procurement's, the clerk's
+  # own code for the clerk's - the two read a key differently, and a check
+  # that read one the other's way would prove something else. A key that no
+  # longer mints is a red patrol within the hour.
+  #
+  # A job of its own, so the patrol that looks at the estate goes on holding
+  # no key at all. tests/go/repo/app_keys_test.go holds this to every App key
+  # any workflow is handed: a new one that is not proved here is refused.
+  # ---------------------------------------------------------------------
+  keys:
+    name: "Every App key still mints"
+    runs-on: ubuntu-latest
+    # Bounded so a stuck job cannot bill a metered vendor for six hours,
+    # which is what GitHub's default timeout allows.
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # Owned by scripts/approved-suppliers.yml under `egress:`, which says
+          # which job may reach what; `security guard-egress` refuses any drift.
+          # The copy lives here because harden-runner reads its policy in a
+          # pre-step, before any step of this job can run.
+          egress-policy: block
+          disable-sudo-and-containers: "true"
+          allowed-endpoints: >
+            api.github.com:443
+            github.com:443
+            go.dev:443
+            objects.githubusercontent.com:443
+            release-assets.githubusercontent.com:443
+            storage.googleapis.com:443
+
+      - name: Read pinned versions
+        uses: ./.github/actions/versions
+
+      # scripts/clerk has no dependencies, so there is nothing to cache.
+      - name: Setup Go
+        uses: $/.github/workflows/setup-go
+
+      # The least a token can be asked for: to read this repository, which
+      # the job could do anyway. The action revokes it when the job ends.
+      - name: Procurement's key mints a token
+        uses: $/.github/workflows/app-token
+        with:
+          client-id: ${{ secrets.PROCUREMENT_BOT_CLIENT_ID }}
+          private-key: ${{ secrets.PROCUREMENT_BOT_PRIVATE_KEY }}
+          permission-contents: read
+          owner: ${{ github.repository_owner }}
+          repositories: ${{ github.event.repository.name }}
+
+      - name: The clerk's key mints a token
+        env:
+          CLERK_BOT_APP_ID: ${{ vars.CLERK_BOT_APP_ID || secrets.CLERK_BOT_APP_ID }}
+          CLERK_BOT_PRIVATE_KEY: ${{ secrets.CLERK_BOT_PRIVATE_KEY }}
+          GITHUB_REPOSITORY: ${{ github.repository }}
+        run: go run -C scripts/clerk . sign-in
