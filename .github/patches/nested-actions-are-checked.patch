diff --git a/tests/go/repo/pinned_actions_test.go b/tests/go/repo/pinned_actions_test.go
new file mode 100644
index 00000000..46d2a185
--- /dev/null
+++ b/tests/go/repo/pinned_actions_test.go
@@ -0,0 +1,142 @@
+package repo
+
+import (
+	"encoding/json"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"homelab/tests/parsed"
+)
+
+// What each pinned action runs, fetched for real from a tree of the test's
+// own (#881).
+//
+// The configuration rules judge what the pinned actions run with no network,
+// so the fetch is all that sees it: one that misses an action an action
+// runs, or that writes nothing and succeeds, passes every rule while GitHub
+// refuses the job after the merge. So it is run here against a repository
+// and a source the test writes, read over file:// the way it reads
+// raw.githubusercontent.com.
+//
+// covers: shell:.github/workflows/offline/pinned-actions.sh
+
+const (
+	outerSHA = "1111111111111111111111111111111111111111"
+	innerSHA = "2222222222222222222222222222222222222222"
+)
+
+// pinnedActionsFixture is a repository naming actions, and a source holding
+// their metadata at their commits.
+type pinnedActionsFixture struct {
+	repo, source string
+	env          []string
+}
+
+func newPinnedActionsFixture(t *testing.T, workflow string) *pinnedActionsFixture {
+	t.Helper()
+	dir := t.TempDir()
+	f := &pinnedActionsFixture{repo: filepath.Join(dir, "repo"), source: filepath.Join(dir, "source")}
+	f.env = []string{
+		"PATH=" + os.Getenv("PATH"),
+		"HOME=" + dir,
+		"GIT_CONFIG_GLOBAL=/dev/null",
+		"GIT_CONFIG_SYSTEM=/dev/null",
+		"PINNED_ACTIONS_SOURCE=file://" + f.source,
+	}
+	write := func(path, body string) {
+		t.Helper()
+		if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write(filepath.Join(f.repo, ".github", "workflows", "w.yml"), workflow)
+	// The outer action runs another by its path in its repository, and an
+	// image, and is read from action.yml.
+	write(filepath.Join(f.source, "owner", "outer", outerSHA, "action.yml"),
+		"runs:\n  using: composite\n  steps:\n"+
+			"    - uses: owner/inner/sub@"+innerSHA+"\n"+
+			"    - uses: docker://example.test/image:1\n"+
+			"    - run: echo not an action\n      shell: bash\n")
+	// The inner one is read from action.yaml, the other name GitHub takes.
+	write(filepath.Join(f.source, "owner", "inner", innerSHA, "sub", "action.yaml"),
+		"runs:\n  using: node24\n  main: index.js\n")
+	for _, args := range [][]string{{"init", "-q", f.repo}, {"-C", f.repo, "add", "-A"}} {
+		cmd := exec.Command("git", args...)
+		cmd.Env = f.env
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v\n%s", args, err, out)
+		}
+	}
+	return f
+}
+
+func (f *pinnedActionsFixture) run(t *testing.T) (map[string][]string, string, error) {
+	t.Helper()
+	out := filepath.Join(t.TempDir(), "pinned-actions.json")
+	stdout, stderr, err := repository(t).Invoke(parsed.Run{In: f.repo, Env: f.env, Bare: true}, "bash", parsed.Here(".github/workflows/offline/pinned-actions.sh"), out)
+	said := string(stdout) + string(stderr)
+	if err != nil {
+		return nil, said, err
+	}
+	body, readErr := os.ReadFile(out)
+	if readErr != nil {
+		t.Fatalf("it succeeded and wrote nothing: %v\n%s", readErr, said)
+	}
+	var got struct {
+		PinnedActions map[string][]string `json:"pinned_actions"`
+	}
+	if err := json.Unmarshal(body, &got); err != nil {
+		t.Fatalf("it wrote what is not JSON of the shape the rules read: %v\n%s", err, body)
+	}
+	return got.PinnedActions, said, nil
+}
+
+// Every action pinned here is fetched, and every action one of those runs,
+// all the way down: by its path in its repository, from either name of its
+// metadata, with what is not pinned by commit kept as written.
+func TestWhatEachPinnedActionRunsIsFetchedAllTheWayDown(t *testing.T) {
+	light(t)
+	f := newPinnedActionsFixture(t, "jobs:\n  a:\n    steps:\n"+
+		"      - uses: owner/outer@"+outerSHA+"\n"+
+		"      - uses: $/.github/workflows/local\n")
+	got, said, err := f.run(t)
+	if err != nil {
+		t.Fatalf("the fetch failed: %v\n%s", err, said)
+	}
+	want := map[string][]string{
+		"owner/outer@" + outerSHA:     {"docker://example.test/image:1", "owner/inner/sub@" + innerSHA},
+		"owner/inner/sub@" + innerSHA: {},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("what the pinned actions run was\n  %v\nwant\n  %v", got, want)
+	}
+}
+
+// An action whose metadata is not where its pin says is refused by name,
+// rather than written down as running nothing.
+func TestAnActionThatCannotBeFetchedIsRefused(t *testing.T) {
+	light(t)
+	f := newPinnedActionsFixture(t, "jobs:\n  a:\n    steps:\n      - uses: owner/gone@"+outerSHA+"\n")
+	_, said, err := f.run(t)
+	if err == nil || !strings.Contains(said, "no action.yml or action.yaml at owner/gone@"+outerSHA) {
+		t.Errorf("an action with no metadata was not refused by name (err %v):\n%s", err, said)
+	}
+}
+
+// A repository that pins nothing by commit is refused: the rules would
+// otherwise judge an empty fetch and pass.
+func TestNothingPinnedIsRefused(t *testing.T) {
+	light(t)
+	f := newPinnedActionsFixture(t, "jobs:\n  a:\n    steps:\n      - uses: owner/outer@v1\n")
+	_, said, err := f.run(t)
+	if err == nil || !strings.Contains(said, "no action here is pinned by commit") {
+		t.Errorf("a repository pinning nothing was not refused (err %v):\n%s", err, said)
+	}
+}
