new file mode 100644
index 00000000..e34c8517
--- /dev/null
+++ b/.github/workflows/offline/pinnedactions/main.go
@@ -0,0 +1,222 @@
+// Command pinnedactions writes what each action this repository pins runs in
+// turn, at the commit it is pinned to, as JSON for the configuration rules to
+// judge with no network (#881):
+//
+//	{"pinned_actions": {"owner/repo[/path]@sha": ["what it runs", ...], ...}}
+//
+// Every action a workflow or a composite action here names by owner and
+// commit is fetched, and every action one of those runs, all the way down:
+// GitHub follows them the same way when a job is set up, and refuses the job
+// if any one is not allowed. Each is read from its metadata (action.yml or
+// action.yaml) at its own commit, and nothing of it is run.
+//
+// What an action runs is written as it names it. One pinned by commit is
+// fetched in turn; anything else - a tag, `./`, `docker://` - is kept as it is
+// written, and the rule refuses what the suppliers list does not name.
+//
+//	pinnedactions <out.json>
+//
+// Run from the top of a checkout by .github/workflows/offline before a check,
+// in the image the check runs in, with the network on: it lives beside that
+// action, behind the same workflows permission, because what runs with a
+// network is not the pull request's to change. YAML is read by Conftest's own
+// parser, the one the rules read it with, which the image holds, so this
+// needs nothing beyond the standard library.
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"path"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+)
+
+// pinned is an action named by owner, repository, path in it, and commit.
+var pinned = regexp.MustCompile(`^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(/[^@]+)?@[0-9a-f]{40}$`)
+
+// sourceEnv points the fetch somewhere other than GitHub; only a test does.
+const sourceEnv = "PINNED_ACTIONS_SOURCE"
+
+const defaultSource = "https://raw.githubusercontent.com"
+
+func main() {
+	if len(os.Args) != 2 {
+		fmt.Fprintln(os.Stderr, "usage: pinnedactions <out.json>")
+		os.Exit(2)
+	}
+	source := os.Getenv(sourceEnv)
+	if source == "" {
+		source = defaultSource
+	}
+	n, err := write(os.Args[1], source, client())
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "pinnedactions:", err)
+		os.Exit(1)
+	}
+	fmt.Printf("pinnedactions: %d action(s) at their commits, written to %s\n", n, os.Args[1])
+}
+
+// client fetches over https, and reads file:// as a test's source.
+func client() *http.Client {
+	transport := http.DefaultTransport.(*http.Transport).Clone()
+	transport.RegisterProtocol("file", http.NewFileTransport(http.Dir("/")))
+	return &http.Client{Transport: transport, Timeout: 30 * time.Second}
+}
+
+// write fetches what every pinned action runs and writes it to out.
+func write(out, source string, c *http.Client) (int, error) {
+	files, err := tracked()
+	if err != nil {
+		return 0, err
+	}
+	named, err := uses(files...)
+	if err != nil {
+		return 0, err
+	}
+	graph, err := fetchAll(named, func(ref string) ([]byte, error) { return metadata(c, source, ref) })
+	if err != nil {
+		return 0, err
+	}
+	body, err := json.MarshalIndent(map[string]map[string][]string{"pinned_actions": graph}, "", "  ")
+	if err != nil {
+		return 0, err
+	}
+	return len(graph), os.WriteFile(out, append(body, '\n'), 0o644)
+}
+
+// tracked is every YAML file under .github the checkout tracks.
+func tracked() ([]string, error) {
+	out, err := exec.Command("git", "ls-files", "-z", "--", ".github/*.yml", ".github/*.yaml").Output()
+	if err != nil {
+		return nil, fmt.Errorf("listing the workflows and actions: %w", err)
+	}
+	var files []string
+	for _, f := range strings.Split(strings.TrimRight(string(out), "\x00"), "\x00") {
+		if f != "" {
+			files = append(files, f)
+		}
+	}
+	return files, nil
+}
+
+// fetchAll follows every pinned action from the ones named here, all the way
+// down, and says what each runs.
+func fetchAll(named []string, fetch func(ref string) ([]byte, error)) (map[string][]string, error) {
+	var queue []string
+	for _, ref := range named {
+		if pinned.MatchString(ref) {
+			queue = append(queue, ref)
+		}
+	}
+	if len(queue) == 0 {
+		return nil, errors.New("no action here is pinned by commit, so there was nothing to fetch, which cannot be right")
+	}
+	graph := map[string][]string{}
+	for len(queue) > 0 {
+		ref := queue[0]
+		queue = queue[1:]
+		if _, seen := graph[ref]; seen {
+			continue
+		}
+		body, err := fetch(ref)
+		if err != nil {
+			return nil, err
+		}
+		runs, err := usesIn(body)
+		if err != nil {
+			return nil, fmt.Errorf("reading what %s runs: %w", ref, err)
+		}
+		graph[ref] = runs
+		for _, r := range runs {
+			if pinned.MatchString(r) {
+				queue = append(queue, r)
+			}
+		}
+	}
+	return graph, nil
+}
+
+// metadata is an action's action.yml, or action.yaml, at its commit.
+func metadata(c *http.Client, source, ref string) ([]byte, error) {
+	name, sha, _ := strings.Cut(ref, "@")
+	parts := strings.SplitN(name, "/", 3)
+	at := strings.TrimSuffix(source, "/") + "/" + path.Join(parts[0], parts[1], sha)
+	if len(parts) == 3 {
+		at += "/" + parts[2]
+	}
+	for _, file := range []string{"action.yml", "action.yaml"} {
+		resp, err := c.Get(at + "/" + file)
+		if err != nil {
+			continue
+		}
+		body, readErr := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		if readErr == nil && resp.StatusCode == http.StatusOK {
+			return body, nil
+		}
+	}
+	return nil, fmt.Errorf("no action.yml or action.yaml at %s, so what it runs is unknown", ref)
+}
+
+// usesIn is what one action's metadata runs.
+func usesIn(body []byte) ([]string, error) {
+	f, err := os.CreateTemp("", "metadata-*.yml")
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = os.Remove(f.Name()) }()
+	if _, err := f.Write(body); err != nil {
+		_ = f.Close()
+		return nil, err
+	}
+	if err := f.Close(); err != nil {
+		return nil, err
+	}
+	return uses(f.Name())
+}
+
+// uses is every `uses:` the files name in any step, wherever it is in them,
+// read as YAML by Conftest's own parser: each once, in order.
+func uses(files ...string) ([]string, error) {
+	args := append([]string{"parse", "--combine", "--parser", "yaml"}, files...)
+	out, err := exec.Command("conftest", args...).Output()
+	if err != nil {
+		return nil, fmt.Errorf("reading %d file(s) as YAML with conftest: %w", len(files), err)
+	}
+	var docs any
+	if err := json.Unmarshal(out, &docs); err != nil {
+		return nil, fmt.Errorf("conftest's reading is not JSON: %w", err)
+	}
+	found := map[string]bool{}
+	walk(docs, found)
+	named := []string{}
+	for ref := range found {
+		named = append(named, ref)
+	}
+	sort.Strings(named)
+	return named, nil
+}
+
+func walk(node any, found map[string]bool) {
+	switch v := node.(type) {
+	case map[string]any:
+		if ref, ok := v["uses"].(string); ok {
+			found[ref] = true
+		}
+		for _, child := range v {
+			walk(child, found)
+		}
+	case []any:
+		for _, child := range v {
+			walk(child, found)
+		}
+	}
+}
diff --git a/.github/workflows/offline/pinnedactions/main_test.go b/.github/workflows/offline/pinnedactions/main_test.go
new file mode 100644
index 00000000..51b54745
--- /dev/null
+++ b/.github/workflows/offline/pinnedactions/main_test.go
@@ -0,0 +1,149 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+const (
+	outerSHA = "1111111111111111111111111111111111111111"
+	innerSHA = "2222222222222222222222222222222222222222"
+)
+
+func TestMain(m *testing.M) {
+	// A fixture repository's git must not read the machine's configuration.
+	_ = os.Setenv("GIT_CONFIG_GLOBAL", os.DevNull)
+	_ = os.Setenv("GIT_CONFIG_SYSTEM", os.DevNull)
+	os.Exit(m.Run())
+}
+
+// fixture is a repository naming actions, and a source holding their
+// metadata at their commits, read over file:// the way GitHub's is over https.
+func fixture(t *testing.T, workflow string) (repo, source string) {
+	t.Helper()
+	dir := t.TempDir()
+	repo, source = filepath.Join(dir, "repo"), filepath.Join(dir, "source")
+	write := func(p, body string) {
+		t.Helper()
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(body), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write(filepath.Join(repo, ".github", "workflows", "w.yml"), workflow)
+	// The outer action runs another by its path in its repository, and an
+	// image, and is read from action.yml.
+	write(filepath.Join(source, "owner", "outer", outerSHA, "action.yml"),
+		"runs:\n  using: composite\n  steps:\n"+
+			"    - uses: owner/inner/sub@"+innerSHA+"\n"+
+			"    - uses: docker://example.test/image:1\n"+
+			"    - run: echo not an action\n      shell: bash\n")
+	// The inner one is read from action.yaml, the other name GitHub takes.
+	write(filepath.Join(source, "owner", "inner", innerSHA, "sub", "action.yaml"),
+		"runs:\n  using: node24\n  main: index.js\n")
+	for _, args := range [][]string{{"init", "-q", repo}, {"-C", repo, "add", "-A"}} {
+		if out, err := exec.Command("git", args...).CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v\n%s", args, err, out)
+		}
+	}
+	return repo, "file://" + source
+}
+
+// run writes the fetch from the fixture repository, as the action runs it.
+func run(t *testing.T, repo, source string) (map[string][]string, error) {
+	t.Helper()
+	t.Chdir(repo)
+	out := filepath.Join(t.TempDir(), "pinned-actions.json")
+	if _, err := write(out, source, client()); err != nil {
+		return nil, err
+	}
+	body, err := os.ReadFile(out)
+	if err != nil {
+		t.Fatalf("it succeeded and wrote nothing: %v", err)
+	}
+	var got struct {
+		PinnedActions map[string][]string `json:"pinned_actions"`
+	}
+	if err := json.Unmarshal(body, &got); err != nil {
+		t.Fatalf("it wrote what is not JSON of the shape the rules read: %v\n%s", err, body)
+	}
+	return got.PinnedActions, nil
+}
+
+// Every action pinned here is fetched, and every action one of those runs,
+// all the way down: by its path in its repository, from either name of its
+// metadata, with what is not pinned by commit kept as written.
+func TestWhatEachPinnedActionRunsIsFetchedAllTheWayDown(t *testing.T) {
+	repo, source := fixture(t, "jobs:\n  a:\n    steps:\n"+
+		"      - uses: owner/outer@"+outerSHA+"\n"+
+		"      - uses: $/.github/workflows/local\n")
+	got, err := run(t, repo, source)
+	if err != nil {
+		t.Fatalf("the fetch failed: %v", err)
+	}
+	want := map[string][]string{
+		"owner/outer@" + outerSHA:     {"docker://example.test/image:1", "owner/inner/sub@" + innerSHA},
+		"owner/inner/sub@" + innerSHA: {},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("what the pinned actions run was\n  %v\nwant\n  %v", got, want)
+	}
+}
+
+// An action whose metadata is not where its pin says is refused by name,
+// rather than written down as running nothing.
+func TestAnActionThatCannotBeFetchedIsRefused(t *testing.T) {
+	repo, source := fixture(t, "jobs:\n  a:\n    steps:\n      - uses: owner/gone@"+outerSHA+"\n")
+	_, err := run(t, repo, source)
+	if err == nil || !strings.Contains(err.Error(), "no action.yml or action.yaml at owner/gone@"+outerSHA) {
+		t.Errorf("an action with no metadata was not refused by name: %v", err)
+	}
+}
+
+// A repository that pins nothing by commit is refused: the rules would
+// otherwise judge an empty fetch and pass.
+func TestNothingPinnedIsRefused(t *testing.T) {
+	repo, source := fixture(t, "jobs:\n  a:\n    steps:\n      - uses: owner/outer@v1\n")
+	_, err := run(t, repo, source)
+	if err == nil || !strings.Contains(err.Error(), "no action here is pinned by commit") {
+		t.Errorf("a repository pinning nothing was not refused: %v", err)
+	}
+}
+
+// Each action is fetched once, however many name it, and a cycle ends.
+func TestAnActionNamedTwiceIsFetchedOnce(t *testing.T) {
+	a, b := "o/a@"+outerSHA, "o/b@"+innerSHA
+	calls := map[string]int{}
+	graph, err := fetchAll([]string{a, a, "o/c@v1"}, func(ref string) ([]byte, error) {
+		calls[ref]++
+		if ref == a {
+			return []byte("runs:\n  steps:\n    - uses: " + b + "\n"), nil
+		}
+		return []byte("runs:\n  steps:\n    - uses: " + a + "\n"), nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if calls[a] != 1 || calls[b] != 1 || len(graph) != 2 {
+		t.Errorf("fetched %v into %v; want each of the two once", calls, graph)
+	}
+}
+
+// A fetch that fails, or metadata that is not YAML, stops the whole fetch.
+func TestAFailedFetchOrUnreadableMetadataStopsIt(t *testing.T) {
+	ref := "o/a@" + outerSHA
+	if _, err := fetchAll([]string{ref}, func(string) ([]byte, error) { return nil, errors.New("down") }); err == nil {
+		t.Error("a failed fetch was taken as running nothing")
+	}
+	if _, err := fetchAll([]string{ref}, func(string) ([]byte, error) { return []byte("runs: [not closed"), nil }); err == nil || !strings.Contains(err.Error(), "reading what "+ref+" runs") {
+		t.Errorf("metadata that is not YAML was taken as running nothing: %v", err)
+	}
+}
