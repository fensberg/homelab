new file mode 100755
index 00000000..b9bc13af
--- /dev/null
+++ b/.github/workflows/offline/pinned-actions.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+# What each action this repository pins runs in turn, at the commit it is
+# pinned to, written as JSON for the configuration rules to judge with no
+# network (#881):
+#
+#   {"pinned_actions": {"owner/repo[/path]@sha": ["what it runs", ...], ...}}
+#
+# Every action a workflow or a composite action here names by owner and
+# commit is fetched, and every action one of those runs, all the way down:
+# GitHub follows them the same way when a job is set up, and refuses the job
+# if any one is not allowed. Each is read from its metadata (action.yml or
+# action.yaml) at its own commit, and nothing of it is run.
+#
+# What an action runs is written as it names it. One pinned by commit is
+# fetched in turn; anything else - a tag, `./`, `docker://` - is kept as it
+# is written, and the rule refuses what the suppliers list does not name.
+#
+#   pinned-actions.sh <out.json>
+#
+# Run by .github/workflows/offline before a check, in the image the check
+# runs in, and by hand before running the configuration rules at a terminal:
+# point PINNED_ACTIONS at what it writes. It reads YAML with conftest and
+# walks it with jq, both of which the image holds.
+set -euo pipefail
+
+out=${1:?usage: pinned-actions.sh <out.json>}
+pinned='^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(/[^@]+)?@[0-9a-f]{40}$'
+
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+# Where an action's metadata is read from, by repository and commit. Only a
+# test points it anywhere else, at a tree of its own.
+source=${PINNED_ACTIONS_SOURCE:-https://raw.githubusercontent.com}
+
+# What the files name in a `uses:` of any step, wherever it is in them: read
+# as YAML by Conftest's own parser, the one the rules read them with.
+named() {
+	conftest parse --combine --parser yaml "$@" | jq -r '.. | objects | select(has("uses")) | .uses | strings'
+}
+
+mapfile -d '' -t files < <(git ls-files -z -- '.github/*.yml' '.github/*.yaml')
+mapfile -t queue < <(named "${files[@]}" | grep -E "$pinned" | sort -u)
+if [ "${#queue[@]}" -eq 0 ]; then
+	echo "pinned-actions: no action here is pinned by commit, so there was nothing to fetch, which cannot be right" >&2
+	exit 1
+fi
+
+declare -A seen=()
+echo '{}' >"$work/graph.json"
+while [ "${#queue[@]}" -gt 0 ]; do
+	ref=${queue[0]}
+	queue=("${queue[@]:1}")
+	if [ -n "${seen[$ref]:-}" ]; then
+		continue
+	fi
+	seen[$ref]=1
+	name=${ref%@*}
+	sha=${ref##*@}
+	repo=$(cut -d/ -f1-2 <<<"$name")
+	path=$(cut -d/ -f3- -s <<<"$name")
+	base="${source}/${repo}/${sha}${path:+/$path}"
+	if ! curl -fsSL --retry 2 "$base/action.yml" -o "$work/metadata" 2>/dev/null &&
+		! curl -fsSL --retry 2 "$base/action.yaml" -o "$work/metadata" 2>/dev/null; then
+		echo "pinned-actions: no action.yml or action.yaml at ${ref}, so what it runs is unknown" >&2
+		exit 1
+	fi
+	mapfile -t runs < <(named "$work/metadata" | sort -u)
+	for r in "${runs[@]}"; do
+		if [[ $r =~ $pinned ]]; then
+			queue+=("$r")
+		fi
+	done
+	printf '%s\n' "${runs[@]}" | jq -R . | jq -s --arg ref "$ref" --slurpfile graph "$work/graph.json" \
+		'map(select(length > 0)) as $runs | $graph[0] + {($ref): $runs}' >"$work/next.json"
+	mv "$work/next.json" "$work/graph.json"
+done
+
+jq '{pinned_actions: .}' "$work/graph.json" >"$out"
+echo "pinned-actions: ${#seen[@]} action(s) at their commits, written to ${out}"
