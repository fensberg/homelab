@@ -0,0 +1,8 @@
+guard: TestEachPoolOfPullRequestRunnersReachesWhatItsJobsDoAndNoMore
+file: clusters/core/infrastructure/configs/pull-requests-source.yaml
+find: "            - port: \"443\"\n"
+replace: "            - port: \"80\"\n"
