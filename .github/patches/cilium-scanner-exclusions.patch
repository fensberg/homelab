diff --git a/.github/workflows/pr-validation.yml b/.github/workflows/pr-validation.yml
index 6a4f0c4..26c4978 100644
--- a/.github/workflows/pr-validation.yml
+++ b/.github/workflows/pr-validation.yml
@@ -651,7 +651,14 @@ jobs:
           fetch-depth: 0
           persist-credentials: false
       - name: Run Semgrep CI
-        run: semgrep ci
+        # clusters/bootstrap/ is Cilium's chart output, committed verbatim so a
+        # version bump is a reviewable diff rather than a one-line pin change.
+        # Its hostNetwork and privilege-escalation findings are true and are
+        # inherent to what a CNI is - it is the node's network. Excluded here
+        # rather than in a root .semgrepignore, because that file REPLACES
+        # semgrep's built-in ignore list rather than adding to it, and silently
+        # losing those defaults is a bigger hole than the one being closed.
+        run: semgrep ci --exclude=clusters/bootstrap
         env:
           SEMGREP_RULES: "p/default"
 
@@ -715,7 +722,16 @@ jobs:
           # misconfiguration in code we control - so this is excluded from
           # scanning entirely rather than suppressing the specific rule IDs
           # project-wide, which would also silence real findings elsewhere.
-          skip-dirs: "clusters/management/flux-system"
+          #
+          # clusters/bootstrap/ is Cilium's chart output, committed for the same
+          # reason and excluded on the same grounds: a CNI runs privileged, on
+          # the host network, with CAP_NET_ADMIN and hostPath mounts, and no
+          # version of one satisfies these rules. The privilege is recorded
+          # deliberately in scripts/approved-suppliers.yml rather than waved
+          # away here. The cost is that a future chart version adding a new
+          # mount would not be flagged; the compensating control is that the
+          # manifest is committed, so it shows up in a pull request diff.
+          skip-dirs: "clusters/management/flux-system,clusters/bootstrap"
 
