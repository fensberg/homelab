diff --git a/tests/go/repo/environment_separation_test.go b/tests/go/repo/environment_separation_test.go
new file mode 100644
index 0000000..9bae486
--- /dev/null
+++ b/tests/go/repo/environment_separation_test.go
@@ -0,0 +1,105 @@
+package repo
+
+import (
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+
+	"gopkg.in/yaml.v3"
+)
+
+// A job that only reads and a job that changes the estate never share a GitHub
+// environment (#438).
+//
+// A reviewer on an environment gates every job that names it, and GitHub cannot
+// tell them apart. So when the plan and the converge shared `management`, a
+// reviewer there asked for a click on every "show me what would change", and
+// the plan - which runs on every pull request - held the converge's read-write
+// vault token. Plans have environments of their own; this keeps it that way.
+//
+// Every job in every workflow is walked. The read-only jobs are declared
+// here, because whether a job writes is a property nothing in the YAML states;
+// every other job naming an environment is treated as one that changes things.
+var readOnlyJobs = map[string]bool{
+	"deploy-infrastructure.yml/plan":        true,
+	"deploy-infrastructure.yml/plan-estate": true,
+	"integration-tests.yml/test":            true,
+}
+
+// An environment's name as a job gives it: a plain string, a map with name:,
+// or an expression choosing between quoted names - the ones after && and ||,
+// not the ones a condition compares against (github.ref_type == 'tag').
+var quotedName = regexp.MustCompile(`(?:&&|\|\|)\s*'([A-Za-z0-9_-]+)'`)
+
+func jobEnvironments(raw any) []string {
+	switch v := raw.(type) {
+	case string:
+		if strings.Contains(v, "${{") {
+			var out []string
+			for _, m := range quotedName.FindAllStringSubmatch(v, -1) {
+				out = append(out, m[1])
+			}
+			return out
+		}
+		return []string{v}
+	case map[string]any:
+		return jobEnvironments(v["name"])
+	}
+	return nil
+}
+
+func TestReadOnlyJobsAndMutatingJobsNeverShareAnEnvironment(t *testing.T) {
+	usedBy := map[string][]string{} // environment -> jobs
+	seen := map[string]bool{}
+	for file, body := range workflowTexts(t) {
+		var wf struct {
+			Jobs map[string]struct {
+				Environment any `yaml:"environment"`
+			} `yaml:"jobs"`
+		}
+		if err := yaml.Unmarshal([]byte(body), &wf); err != nil {
+			t.Fatalf("parsing %s: %v", file, err)
+		}
+		for name, job := range wf.Jobs {
+			id := file + "/" + name
+			seen[id] = true
+			for _, env := range jobEnvironments(job.Environment) {
+				usedBy[env] = append(usedBy[env], id)
+			}
+		}
+	}
+
+	for id := range readOnlyJobs {
+		if !seen[id] {
+			t.Errorf("%s is declared read-only and no longer exists: delete it from readOnlyJobs", id)
+		}
+	}
+	if len(usedBy) == 0 {
+		t.Fatal("no job names an environment, so this checked nothing")
+	}
+
+	envs := make([]string, 0, len(usedBy))
+	for env := range usedBy {
+		envs = append(envs, env)
+	}
+	sort.Strings(envs)
+	for _, env := range envs {
+		var reads, writes []string
+		for _, id := range usedBy[env] {
+			if readOnlyJobs[id] {
+				reads = append(reads, id)
+			} else {
+				writes = append(writes, id)
+			}
+		}
+		if len(reads) > 0 && len(writes) > 0 {
+			sort.Strings(reads)
+			sort.Strings(writes)
+			t.Errorf("the environment %q is named by read-only %v and by %v, which change things.\n\n"+
+				"A reviewer on it would gate the read-only job too, and the read-only job holds whatever "+
+				"credential the other needs. Give the read-only job an environment of its own (#438).",
+				env, reads, writes)
+		}
+	}
+}
diff --git a/tests/js/unit/plan-absence-comment.test.ts b/tests/js/unit/plan-absence-comment.test.ts
new file mode 100644
index 0000000..145931b
--- /dev/null
+++ b/tests/js/unit/plan-absence-comment.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it } from "vitest";
+import { createRequire } from "node:module";
+
+// The comment that says a management change went unplanned. It runs whenever
+// the plan job did not succeed - and since a newer push or a closed pull
+// request now cancels a plan (#438), "cancelled" often means "replaced", not
+// "missing". This holds it to speaking only when the plan it is about was
+// for the pull request as it stands.
+const require = createRequire(import.meta.url);
+const comment = require("../../../.github/workflows/github-script/plan-absence-comment.js");
+
+function fakeGitHub(pr: { state: string; head: { sha: string } }) {
+  const created: string[] = [];
+  const github = {
+    rest: {
+      pulls: { get: async () => ({ data: pr }) },
+      issues: {
+        listComments: async () => ({ data: [] }),
+        deleteComment: async () => ({}),
+        createComment: async ({ body }: { body: string }) => {
+          created.push(body);
+          return {};
+        },
+      },
+    },
+  };
+  const context = {
+    repo: { owner: "example", repo: "homelab" },
+    issue: { number: 7 },
+    payload: { pull_request: { head: { sha: "run-head" } } },
+  };
+  return { github, context, created };
+}
+
+describe("the plan-absence comment", () => {
+  it("speaks when the plan for the current head did not run", async () => {
+    const { github, context, created } = fakeGitHub({ state: "open", head: { sha: "run-head" } });
+    process.env.RESULT = "cancelled";
+    await comment({ github, context });
+    expect(created).toHaveLength(1);
+    expect(created[0]).toContain("No plan was produced");
+  });
+
+  it("stays quiet when a newer push replaced the plan", async () => {
+    const { github, context, created } = fakeGitHub({ state: "open", head: { sha: "newer" } });
+    await comment({ github, context });
+    expect(created).toHaveLength(0);
+  });
+
+  it("stays quiet when the pull request closed", async () => {
+    const { github, context, created } = fakeGitHub({ state: "closed", head: { sha: "run-head" } });
+    await comment({ github, context });
+    expect(created).toHaveLength(0);
+  });
+});
