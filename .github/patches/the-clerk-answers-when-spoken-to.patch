+    # elevation fired this twice, and the concurrency group below cancelled one
+    # of them by luck rather than by design, part-way through a metered call.
+    # The clerk cannot be requested as a reviewer either, so there was nothing
+    # to filter on.
+    types: [ready_for_review]
+
+  # Asked again, without changing the pull request's state.
+  #
+  #   @clerk snag       walk the work again
+  #   @clerk handover   read it again as a stranger
+  #
+  # The Dependabot shape, and it beats re-requesting a review: it is explicit,
+  # it works on a draft, it says which reading is wanted, and it leaves a record
+  # in the conversation of who asked for what.
+  issue_comment:
+    types: [created]
 
