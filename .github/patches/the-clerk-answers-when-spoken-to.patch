-      # Full history: snag reads the files this change touches, and a shallow
-      # clone does not have the base to compare against.
+      # Heard you. Dependabot reacts rather than replying, and it is the right
+      # shape: an acknowledgement that costs no comment and no notification.
+      # Eyes now, thumbs up when it is done.
+      - name: Acknowledge the request
+        if: github.event_name == 'issue_comment'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          REPO: ${{ github.repository }}
+          COMMENT: ${{ github.event.comment.id }}
+        run: |
+          gh api -X POST "repos/$REPO/issues/comments/$COMMENT/reactions" -f content=eyes --silent
+
+      # Which pull request, and which commits.
+      #
+      # A pull_request event carries them; an issue_comment carries only the
+      # issue number, because the comment is on the conversation rather than on
+      # the change. So they are resolved once here and every later step reads
+      # the same two values whichever way it was asked.
+      - name: Resolve the change
+        id: change
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          REPO: ${{ github.repository }}
+          NUMBER: ${{ github.event.pull_request.number || github.event.issue.number }}
+        run: |
+          gh api "repos/$REPO/pulls/$NUMBER" \
+            --jq '"pr=\(.number)\nbase=\(.base.sha)\nhead=\(.head.sha)\nref=\(.head.ref)"' \
+            >>"$GITHUB_OUTPUT"
+
+      # What was asked for. Elevation asks for both readings; a comment asks
+      # for the one it names.
+      - name: What was asked
+        id: ask
+        env:
+          BODY: ${{ github.event.comment.body }}
+          EVENT: ${{ github.event_name }}
+        run: |
+          if [ "$EVENT" != "issue_comment" ]; then
+            echo "verbs=snag handover" >>"$GITHUB_OUTPUT"
+            exit 0
+          fi
+          case "$(printf '%s' "$BODY" | tr -d '\r' | head -1)" in
+            "@clerk snag"*)     echo "verbs=snag" >>"$GITHUB_OUTPUT" ;;
+            "@clerk handover"*) echo "verbs=handover" >>"$GITHUB_OUTPUT" ;;
+            *)                  echo "verbs=" >>"$GITHUB_OUTPUT" ;;
+          esac
+
+      # Nothing recognised, so say so and stop. A reaction rather than a
+      # comment: not every action needs an explicit output, and a confused face
+      # says "seen, not understood" without adding to the conversation.
+      - name: Say the command was not understood
+        if: steps.ask.outputs.verbs == ''
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          REPO: ${{ github.repository }}
+          COMMENT: ${{ github.event.comment.id }}
+        run: |
+          gh api -X POST "repos/$REPO/issues/comments/$COMMENT/reactions" -f content=confused --silent
+          echo "::notice::known commands are '@clerk snag' and '@clerk handover'"
+
+      # refs/pull/N/head rather than the head SHA, and that is what makes a
+      # RETROACTIVE reading possible.
+      #
+      # An issue_comment run starts on the default branch, so the change has to
+      # be fetched explicitly either way. But a merged pull request is the
+      # interesting case: this repository squash-merges, so the head commit is
+      # not an ancestor of main and its branch is deleted on merge - a checkout
+      # by SHA would find nothing. GitHub keeps refs/pull/N/head forever, so
+      # `@clerk snag` works on a pull request that landed months ago exactly as
+      # it does on one still open.
+      #
+      # That is worth having on purpose rather than by accident: it means the
+      # clerk can be pointed at work that was merged before it existed.
       - name: Checkout Code
+        if: steps.ask.outputs.verbs != ''
         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
         with:
+          ref: refs/pull/${{ steps.change.outputs.pr }}/head
           fetch-depth: 0
           persist-credentials: false
 
