diff --git a/.github/workflows/expediter.yml b/.github/workflows/expediter.yml
index 8579c5e..e83a74c 100644
--- a/.github/workflows/expediter.yml
+++ b/.github/workflows/expediter.yml
@@ -224,14 +224,23 @@ jobs:
           # fail; the Dockerfile learned the same thing.
           "$steam/steamcmd.sh" +quit >/dev/null 2>&1 || true
 
-          build=""
-          for attempt in 1 2 3; do
-            info="$("$steam/steamcmd.sh" +login anonymous +app_info_update 1 +app_info_print "$APP_ID" +quit || true)"
-            build="$(awk '/"branches"/ {b=1} b && /"public"/ {p=1} p && /"buildid"/ {gsub(/[^0-9]/, ""); print; exit}' <<<"$info")"
-            [ -n "$build" ] && break
-            echo "attempt ${attempt}: Steam did not report a public build; retrying" >&2
-            sleep 15
-          done
+          # Through scripts/retry.sh rather than a loop of its own.
+          #
+          # This was a hand-rolled `for attempt in 1 2 3`, and it was the second
+          # implementation of one policy - bounded attempts, never a verdict,
+          # every attempt reported. Two is two places for that to drift and the
+          # third would have been written by somebody who knew about neither.
+          #
+          # The helper refuses anything not on its declared list, so a caller
+          # cannot quietly start retrying a check. steamcmd is on that list
+          # because Valve's app_info lookup reports no public build under load,
+          # which has nothing to do with the change being tested.
+          info=""
+          if scripts/retry.sh 3 15 "$steam/steamcmd.sh" +login anonymous \
+            +app_info_update 1 +app_info_print "$APP_ID" +quit >"$TMPDIR/steam.out" 2>&1; then
+            info="$(cat "$TMPDIR/steam.out")"
+          fi
+          build="$(awk '/"branches"/ {b=1} b && /"public"/ {p=1} p && /"buildid"/ {gsub(/[^0-9]/, ""); print; exit}' <<<"$info")"
           if [ -z "$build" ]; then
             echo "::error::Steam reported no public build for app ${APP_ID}, so there is nothing to compare"
             exit 1
