diff --git a/.github/workflows/pool-proof/action.yml b/.github/workflows/pool-proof/action.yml
index c984146..65dd871 100644
--- a/.github/workflows/pool-proof/action.yml
+++ b/.github/workflows/pool-proof/action.yml
@@ -10,6 +10,17 @@ description: >-
 #
 # It is also what says a pool works at all, before any job a merge is held
 # to is moved onto it. Nothing waits on these jobs.
+inputs:
+  reaches:
+    description: >-
+      A host declared for this pool, which must answer: one this pool has
+      and a narrower pool does not, so the proof is of this pool's own list.
+    required: true
+  refused:
+    description: A host no job declares, which must not answer.
+    required: false
+    default: https://example.com
+
 runs:
   using: composite
   steps:
@@ -24,22 +35,27 @@ runs:
 
     - name: A host the pool is declared to reach answers
       shell: bash
+      env:
+        REACHES: ${{ inputs.reaches }}
       run: |
         set -euo pipefail
-        if ! curl --silent --show-error --max-time 20 --output /dev/null https://github.com; then
-          echo "::error::github.com is declared for every pool and did not answer. The pool is refusing everything, so the refusals below would prove nothing."
+        if ! curl --silent --show-error --max-time 20 --output /dev/null "${REACHES}"; then
+          echo "::error::${REACHES} is declared for this pool and did not answer. Either the pool's policy does not carry its list, or it is refusing everything and the refusals below would prove nothing."
           exit 1
         fi
+        echo "${REACHES} answered"
 
     - name: A host nobody declared is refused
       shell: bash
+      env:
+        REFUSED: ${{ inputs.refused }}
       run: |
         set -euo pipefail
-        if curl --silent --show-error --max-time 20 --output /dev/null https://example.com; then
-          echo "::error::example.com answered. No job declares it, so the pool's policy is not holding its runners to the hosts declared for it."
+        if curl --silent --show-error --max-time 20 --output /dev/null "${REFUSED}"; then
+          echo "::error::${REFUSED} answered. No job declares it, so the pool's policy is not holding its runners to the hosts declared for it."
           exit 1
         fi
-        echo "example.com was refused"
+        echo "${REFUSED} was refused"
 
     - name: The cluster's own API is refused
       shell: bash
diff --git a/.github/workflows/pr-validation.yml b/.github/workflows/pr-validation.yml
