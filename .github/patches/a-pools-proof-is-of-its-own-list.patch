@@ -1661,6 +1666,9 @@ jobs:
           allowed-endpoints: >
             api.github.com:443
             github.com:443
+            registry.npmjs.org:443
 
       - name: Prove the pool holds
         uses: $/.github/workflows/pool-proof
+        with:
+          reaches: https://registry.npmjs.org
