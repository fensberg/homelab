diff --git a/.github/workflows/sensitive-paths.yml b/.github/workflows/sensitive-paths.yml
index b10aa17..a278679 100644
--- a/.github/workflows/sensitive-paths.yml
+++ b/.github/workflows/sensitive-paths.yml
@@ -60,6 +60,45 @@ jobs:
       # The comment body is built entirely by the script, so changing the
       # wording never means touching this file. Copy that needs a workflow edit
       # to fix is copy that stays wrong, and the agent cannot edit workflows.
+      # A push invalidates the acknowledgement, by removing it.
+      #
+      # GitHub dismisses stale *reviews* when a branch moves and never touches
+      # labels, so `sensitive-reviewed` survived every subsequent commit. The
+      # sequence that exploits it needs no intent at all: touch a sensitive
+      # path, read the comment, apply the label, then push a fixup. The gate is
+      # now satisfied for a diff nobody has looked at, and the fixup is exactly
+      # where a deleted assertion would hide.
+      #
+      # Removing the label on synchronize is the same behaviour branch
+      # protection already applies to reviews, done by hand because GitHub does
+      # not offer it for labels. It runs before the check below so there is no
+      # window in which a stale label is read.
+      #
+      # Deliberately not conditioned on `tripped`: a push that stops touching a
+      # sensitive path should also clear the acknowledgement, or the label
+      # lingers and pre-approves whatever a later commit reintroduces.
+      - name: Dismiss the acknowledgement when the branch moves
+        if: github.event.action == 'synchronize'
+        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
+        with:
+          script: |
+            const label = 'sensitive-reviewed';
+            try {
+              await github.rest.issues.removeLabel({
+                owner: context.repo.owner, repo: context.repo.repo,
+                issue_number: context.issue.number, name: label,
+              });
+              core.notice(
+                `Removed '${label}': the branch moved, so the previous ` +
+                `acknowledgement described a diff that no longer exists. ` +
+                `Read the change and re-apply it.`);
+            } catch (e) {
+              // 404 is the ordinary case - the label was not applied. Anything
+              // else must fail the job: silently failing to remove it leaves
+              // exactly the stale acknowledgement this step exists to prevent.
+              if (e.status !== 404) { throw e; }
+            }
+
       - name: Say what is at risk
         if: steps.sensor.outputs.tripped == 'true'
         uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3 # v9.0.0
diff --git a/tests/go/repo/tripwire_ack_test.go b/tests/go/repo/tripwire_ack_test.go
index 3a4dd9d..0c0e8dc 100644
--- a/tests/go/repo/tripwire_ack_test.go
+++ b/tests/go/repo/tripwire_ack_test.go
@@ -120,3 +120,67 @@ func TestABotCannotAcknowledge(t *testing.T) {
 			"anybody having looked at anything.")
 	}
 }
+
+// A push must invalidate the acknowledgement.
+//
+// GitHub dismisses stale reviews when a branch moves and never touches labels,
+// so `sensitive-reviewed` survived every later commit. The sequence needs no
+// intent: touch a sensitive path, read the comment, apply the label, push a
+// fixup. The gate is then satisfied for a diff nobody has looked at, and a
+// fixup is exactly where a deleted assertion hides.
+//
+// Recorded as the third defect in #108 and described there as unfixable
+// without an attestation bound to content. That was wrong: removing the label
+// on `synchronize` is the same thing branch protection already does to
+// reviews, and GitHub simply does not offer it for labels - so the workflow
+// does it by hand.
+func TestAPushDismissesTheAcknowledgement(t *testing.T) {
+	body := readSensitivePathsWorkflow(t)
+
+	if !strings.Contains(body, "removeLabel") {
+		t.Fatal("nothing removes 'sensitive-reviewed' when the branch moves.\n\n" +
+			"Label, then push: the gate passes for a diff nobody read. GitHub " +
+			"dismisses stale reviews on a push and never touches labels, so this " +
+			"has to be done by hand.")
+	}
+	if !strings.Contains(body, "synchronize") {
+		t.Error("the dismissal is not tied to a push, so it either never fires or " +
+			"fires when it should not")
+	}
+
+	// Ordering matters: a dismissal after the check reads a label that is
+	// about to be removed, which is the same hole with extra steps.
+	dismiss := strings.Index(body, "removeLabel")
+	require := strings.Index(body, "Require an explicit acknowledgement")
+	if dismiss > require {
+		t.Error("the label is dismissed after the acknowledgement is checked, so the " +
+			"check still reads the stale one")
+	}
+}
+
+// The dismissal must not be conditioned on the tripwire firing. A push that
+// stops touching a sensitive path should also clear the label, or it lingers
+// and pre-approves whatever a later commit reintroduces.
+func TestTheDismissalIsNotConditionedOnTripping(t *testing.T) {
+	body := readSensitivePathsWorkflow(t)
+	i := strings.Index(body, "Dismiss the acknowledgement")
+	if i < 0 {
+		t.Skip("no dismissal step yet; TestAPushDismissesTheAcknowledgement covers that")
+	}
+	step := body[i:min(i+400, len(body))]
+	if strings.Contains(step, "steps.sensor.outputs.tripped") {
+		t.Error("the dismissal only fires when the tripwire trips, so a push that stops " +
+			"touching a sensitive path leaves the label in place to pre-approve the next " +
+			"commit that starts touching one again")
+	}
+}
+
+func readSensitivePathsWorkflow(t *testing.T) string {
+	t.Helper()
+	path := filepath.Join(repoRoot(t), ".github", "workflows", "sensitive-paths.yml")
+	body, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("reading %s: %v", path, err)
+	}
+	return string(body)
+}
