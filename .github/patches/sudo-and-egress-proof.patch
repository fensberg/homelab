+  # in every job was considered and not built: with sudo, a later step could
+  # undo it, which is why sudo is removed instead (#410).
+  #
+  # THE CONTROL. `egress-reachable` shows the probe host answers when nothing
+  # restricts it, so a refusal in `egress-blocked` is the policy and not an
+  # outage. When this was first proven it also ran harden-runner directly as a
+  # second control; nothing runs it directly any more, and keeping that job
+  # would have been a second place its commit is written.
+  #
+  # The probe host is example.com: reserved by IANA for exactly this kind of
+  # use, and on no job's allowlist anywhere in scripts/approved-suppliers.yml.
+  # -----------------------------------------------------------------
+  egress-reachable:
+    name: "Egress Proof (probe host answers unrestricted)"
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: read
+    env:
+      PROBE: https://example.com
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # Owned by scripts/approved-suppliers.yml under `egress:`, which says
+          # which job may reach what; `security guard-egress` refuses any drift.
+          egress-policy: audit
+          disable-sudo-and-containers: "true"
+          checkout: "false"
+
+      - name: The probe host answers
+        run: |
+          if ! curl --silent --show-error --max-time 20 --output /dev/null "$PROBE"; then
+            echo "::error::$PROBE did not answer with nothing blocking it, so a refusal in egress-blocked would prove nothing. Choose a probe host reachable from a GitHub-hosted runner."
+            exit 1
+          fi
+          echo "$PROBE answers when unrestricted."
+
+  egress-blocked:
+    name: "Egress Proof (block holds, sudo is gone)"
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: read
+    env:
+      PROBE: https://example.com
+      ALLOWED: https://github.com
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # Owned by scripts/approved-suppliers.yml under `egress:`, which says
+          # which job may reach what; `security guard-egress` refuses any drift.
+          egress-policy: block
+          allowed-endpoints: >
+            api.github.com:443
+            github.com:443
+          disable-sudo-and-containers: "true"
+
+      - name: The repository was checked out
+        run: |
+          if [ ! -f CLAUDE.md ]; then
+            echo "::error::mobilize ran and the workspace holds no checkout."
+            exit 1
+          fi
+
+      # The protection that makes a block stay a block. With sudo, any later
+      # step in a job can stop harden-runner's agent or flush its rules and
+      # then call out (#410).
+      - name: Sudo is gone
+        run: |
+          if sudo -n true 2>/dev/null; then
+            echo "::error::sudo still works after mobilize with disable-sudo-and-containers: \"true\". Any step in a blocking job could switch egress enforcement off."
+            exit 1
+          fi
+          echo "sudo is refused, so no later step can dismantle enforcement."
+
+      - name: An allowed host answers
+        run: |
+          if ! curl --silent --show-error --max-time 20 --output /dev/null "$ALLOWED"; then
+            echo "::error::$ALLOWED is on this job's allowlist and did not answer. The block is refusing everything, so a refused probe below would not show that it refuses selectively."
+            exit 1
+          fi
+
+      - name: The probe host is refused
+        run: |
+          if curl --silent --show-error --max-time 20 --output /dev/null "$PROBE"; then
+            echo "::error::$PROBE answered under egress-policy: block through mobilize. harden-runner's policy was not installed, so every job in this repository is unwatched while reporting green."
+            exit 1
+          fi
+          echo "$PROBE was refused: harden-runner enforces block through mobilize."
+
+      # The plan-comment scripts are files beside the shared github-script
+      # action and read their values from process.env set on the calling step.
+      # Those jobs run only on infrastructure changes, so a script that cannot be
+      # read under $/, or env that stopped arriving, is found here first.
+      - name: A calling step's env reaches a script beside the shared action
+        uses: $/.github/workflows/github-script
+        env:
+          PROOF: reached
+        with:
+          name: env-reaches-script
