+    timeout-minutes: 35
     permissions:
       contents: read
     steps:
@@ -932,6 +934,12 @@ jobs:
       # about half its time, and here they run beside it instead of after it.
       - name: Prove the guards fail when they should
         working-directory: tests/go
+        env:
+          # Go's default of ten minutes is not a budget anybody set, and the
+          # two tests together passed it on #779 while the ledger was being
+          # made faster: the bound stopped the work that shortens it. This is
+          # a ceiling for a stuck run, not the target; the lane's own time is.
+          GOFLAGS: -timeout=30m
         run: go test ./repo/ -run "$META_TESTS"
 
   test-js:
