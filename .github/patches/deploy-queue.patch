+++ b/.github/workflows/deploy-infrastructure.yml
@@ -1,5 +1,13 @@
 name: Deploy Infrastructure
 
+# Named for what each run does (#155). A pull request only plans and a merge
+# converges, and "Deploy Infrastructure  main  Queued" could not say which -
+# so cancelling one at 2am was a guess about whether it lost a plan or
+# prevented an apply.
+run-name: >-
+  ${{ github.event_name == 'pull_request' && format('Plan: {0}', github.event.pull_request.title)
+  || format('Converge: {0}', github.event.head_commit.message) }}
+
 # Two halves of one gate.
 #
 # A pull request touching infrastructure gets a plan, posted back to it. A
@@ -15,6 +23,11 @@ name: Deploy Infrastructure
 # first real deployment and awkward to retrofit after.
 on:
   pull_request:
+    # closed as well, so closing a pull request cancels its plan: the run it
+    # starts joins the same concurrency group, cancels whatever of that pull
+    # request is still queued, and does nothing itself. A plan left waiting
+    # for a runner fires the day one exists, against a tree nobody wants.
+    types: [opened, synchronize, reopened, closed]
     paths:
       - "environments/**/infrastructure/**"
       - "modules/infrastructure/**"
@@ -35,11 +48,14 @@ on:
 permissions:
   contents: read
 
-# One at a time, and never cancelled mid-flight. There is one estate and one
-# state lock; a cancelled apply is how state gets left locked or half-written.
+# One at a time per ref. A converge is never cancelled mid-flight: there is one
+# estate and one state lock, and a cancelled apply is how state gets left
+# locked or half-written. A pull request's plan is: it reads and changes
+# nothing, so a newer push, or the pull request closing, replaces it rather
+# than queueing behind it. Only the newest plan of a pull request ever waits.
 concurrency:
   group: deploy-infrastructure-${{ github.ref }}
-  cancel-in-progress: false
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
 
 # GitHub's default shell for `run:` is `bash -e {0}`, which has no
 # pipefail: in `a | b` only b's exit status counts, so a failing command
@@ -72,6 +88,9 @@ jobs:
   # ---------------------------------------------------------------------
   changes:
     name: What changed
+    # Nothing to plan for a pull request that has closed; that run exists only
+    # to cancel the plan before it.
+    if: github.event.action != 'closed'
     runs-on: ubuntu-latest
     # Bounded so a stuck job cannot bill a metered vendor for six hours,
     # which is what GitHub's default timeout allows.
