diff --git a/.github/workflows/converge-estate.yml b/.github/workflows/converge-estate.yml
new file mode 100644
index 0000000..520ad31
--- /dev/null
+++ b/.github/workflows/converge-estate.yml
@@ -0,0 +1,104 @@
+name: Converge Estate
+
+run-name: "Converge the estate: ${{ github.event.head_commit.message }}"
+
+# The estate is applied when what declares it is merged, and by nothing
+# else here. Until this it was applied when somebody remembered to: a wall
+# written in git and merged stood nowhere until a person ran the lawyer.
+#
+# NEVER FROM A PULL REQUEST. This is the one job handed the estate's own
+# credential, which can take every wall of the repository down. Three things
+# hold that, none of them in this file's gift:
+#
+#   - the `estate` environment hands its secret to a job on the default
+#     branch and to no other (management/estate/repository/environments.tf);
+#   - the estate's runners take this workflow only as it is on the default
+#     branch (management/estate/source-control.tf);
+#   - tests/go/repo refuses a pull request's job on the estate's runner.
+#
+# Not on a timer yet. A setting changed by hand at the source control stays
+# changed until the next merge here (#535).
+on:
+  push:
+    branches: [main]
+    paths:
+      - "management/estate/**"
+      - "config/estate.tpl.json"
+      - "scripts/lawyer/**"
+
+permissions:
+  contents: read
+
+# One at a time, and never cancelled: an apply stopped part-way is the
+# state nobody can reason about.
+concurrency:
+  group: converge-estate
+  cancel-in-progress: false
+
+defaults:
+  run:
+    shell: bash
+
+jobs:
+  # The estate has no runner of its own; it borrows a site's. Which site is
+  # read from the config and not written here.
+  runner:
+    name: Which runner
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: read
+    outputs:
+      site: ${{ steps.site.outputs.site }}
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # Owned by scripts/approved-suppliers.yml under `egress:`.
+          egress-policy: block
+          disable-sudo-and-containers: "true"
+          allowed-endpoints: >
+            api.github.com:443
+            github.com:443
+
+      - name: Pick the first site the config declares
+        id: site
+        run: |
+          site="$(jq -r '.sites | keys | first // empty' config/management.tpl.json)"
+          if [ -z "${site}" ]; then
+            echo "::error::the config declares no site, so there is no runner to converge the estate from"
+            exit 1
+          fi
+          echo "site=${site}" >> "$GITHUB_OUTPUT"
+
+  converge:
+    name: Converge the estate
+    needs: runner
+    runs-on: homelab-${{ needs.runner.outputs.site }}
+    environment: estate
+    permissions:
+      contents: read
+    timeout-minutes: 30
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # audit, because harden-runner does nothing on this runner whatever
+          # it is told; see this job's entry in scripts/approved-suppliers.yml.
+          egress-policy: audit
+          disable-sudo-and-containers: "false"
+
+      - name: Read pinned versions
+        uses: $/.github/actions/versions
+
+      # No cache, for the reason the site's converge gives: on a self-hosted
+      # runner it persists between jobs, which is a poisoning surface.
+      - name: Setup Go
+        uses: $/.github/workflows/setup-go
+
+      # The lawyer knows this log is public and shows nothing tofu prints:
+      # each thing by its address and what is done to it, and never a value.
+      - name: Converge
+        env:
+          OP_SERVICE_ACCOUNT_TOKEN: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
+        run: go run -C scripts/lawyer . converge-estate
