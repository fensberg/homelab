diff --git a/.github/workflows/mobilize/action.yml b/.github/workflows/mobilize/action.yml
index e062efe..af5ef34 100644
--- a/.github/workflows/mobilize/action.yml
+++ b/.github/workflows/mobilize/action.yml
@@ -111,6 +111,21 @@ runs:
           sudo ss -H -lunp 'sport = :53' || true
           sudo ss -H -ltnp 'sport = :53' || true
           echo "::endgroup::"
+          # What that is. On 2026-10-12 the holder was a process named
+          # dns-resolver, started before the job's own worker, so it is the
+          # runner's and not the agent's or anything of this repository's.
+          # Its command, what started it, the unit it belongs to and what
+          # the runner is told to resolve by say whether it can be stood
+          # down before the agent starts.
+          echo "::group::What the holder of the port is"
+          for pid in $(sudo ss -H -lunp 'sport = :53' | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u); do
+            sudo ps -o pid,ppid,user,lstart,args -p "$pid" || true
+            sudo readlink "/proc/$pid/exe" || true
+            sudo systemctl status "$pid" --no-pager 2>&1 | head -8 || true
+          done
+          echo "--- /etc/resolv.conf"
+          cat /etc/resolv.conf || true
+          echo "::endgroup::"
           echo "::group::The agent's own account of itself"
           sudo systemctl status agent --no-pager 2>&1 | head -20 || true
           sudo journalctl -u agent --no-pager -n 40 2>&1 || true
