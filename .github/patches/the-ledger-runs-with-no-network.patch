diff --git a/tests/mutations/TestTheConfigurationRulesHold.an-offline-job-checking-on-the-runner.yml b/tests/mutations/TestTheConfigurationRulesHold.an-offline-job-checking-on-the-runner.yml
new file mode 100644
index 00000000..83279001
--- /dev/null
+++ b/tests/mutations/TestTheConfigurationRulesHold.an-offline-job-checking-on-the-runner.yml
@@ -0,0 +1,9 @@
+guard: TestTheConfigurationRulesHold
+rule: offline_jobs
+file: .github/workflows/pr-validation.yml
+find: "      - name: Removing an application breaks nothing outside it\n        uses: $/.github/workflows/offline\n        with:\n"
+replace: "      - name: Removing an application breaks nothing outside it\n        uses: $/.github/workflows/checkout\n        with:\n"
+mentions: "pr-validation.yml/removal is offline, and no step of it runs $/.github/workflows/offline"
+why: >
+  An offline job whose check is handed to another action is not run with
+  no network at all, though the list says it is.
diff --git a/tests/mutations/TestTheConfigurationRulesHold.an-offline-job-with-a-step-of-its-own.yml b/tests/mutations/TestTheConfigurationRulesHold.an-offline-job-with-a-step-of-its-own.yml
new file mode 100644
index 00000000..e30f1914
--- /dev/null
+++ b/tests/mutations/TestTheConfigurationRulesHold.an-offline-job-with-a-step-of-its-own.yml
@@ -0,0 +1,10 @@
+guard: TestTheConfigurationRulesHold
+rule: offline_jobs
+file: .github/workflows/pr-validation.yml
+find: "      - name: Prove the guards fail when they should\n        uses: $/.github/workflows/offline\n"
+replace: "      - name: Take delivery on the runner\n        run: go mod download\n\n      - name: Prove the guards fail when they should\n        uses: $/.github/workflows/offline\n"
+mentions: "pr-validation.yml/meta is offline, and its step 2 (Take delivery on the runner) runs on the runner"
+why: >
+  A step of an offline job's own runs on the runner, which has a network:
+  the pull request's code it runs could reach anything. The plausible way
+  there is a setup step put back beside the check.
