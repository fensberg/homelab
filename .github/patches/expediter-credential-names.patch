--- a/.github/workflows/expediter.yml
+++ b/.github/workflows/expediter.yml
@@ -42,9 +42,12 @@ name: "Expediter"
 # Configuration, all on the repository rather than in this file so a fork
 # brings its own:
 #
-#   vars.EXPEDITER_CLIENT_ID     the GitHub App's client ID
-#   vars.EXPEDITER_LOGIN         its bot login, e.g. <app-slug>[bot]
