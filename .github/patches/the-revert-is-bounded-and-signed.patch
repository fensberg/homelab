         run: |
+          # Nothing under management/ changed, so there is nothing a converge
+          # would have applied and nothing to return.
+          if git diff --quiet "$SHA^" "$SHA" -- management/; then
+            echo "::notice::the failed converge changed nothing under management/, so main already describes the estate"
+            exit 0
+          fi
+
+          before=$(git rev-parse "$SHA^:management")
+          root=$(git rev-parse "$SHA^{tree}")
