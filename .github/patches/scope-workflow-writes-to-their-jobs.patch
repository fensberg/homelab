diff --git a/.github/workflows/clerk.yml b/.github/workflows/clerk.yml
index fad09c3..65e1abf 100644
--- a/.github/workflows/clerk.yml
+++ b/.github/workflows/clerk.yml
@@ -56,12 +56,17 @@ on:
   issue_comment:
     types: [created]
 
+# Workflow-level: read and nothing else.
+#
+# The writes this needs are granted on the one job that needs them, below.
+# A workflow-level write is held by every job in the file - here that is one
+# job, so the practical difference is nil and the reviewable difference is
+# not: a second job added later would silently inherit the ability to upload
+# security findings and comment on pull requests. Scorecard flags the
+# workflow-level form as `topLevel 'security-events' permission set to
+# 'write'`, and it is right that the narrower place is the job.
 permissions:
   contents: read
-  # To upload SARIF. Alerts are attributed to the tool name in the report, so
-  # the clerk App keeps its own narrow grant and is not used here at all.
-  security-events: write
-  pull-requests: write
 
 concurrency:
   # One read per pull request. A second request supersedes a first that is
@@ -76,6 +81,13 @@ defaults:
 jobs:
   read:
     name: An outside reading
+    permissions:
+      contents: read
+      # To upload SARIF. Alerts are attributed to the tool name in the
+      # report, so the clerk App keeps its own narrow grant and is not used
+      # here at all.
+      security-events: write
+      pull-requests: write
     # Two ways in, and the second needs a gate the first does not.
     #
     # issue_comment fires for anybody who can comment, and on a public
diff --git a/.github/workflows/runner-image.yml b/.github/workflows/runner-image.yml
index 5d1fab2..6e0bce5 100644
--- a/.github/workflows/runner-image.yml
+++ b/.github/workflows/runner-image.yml
@@ -12,9 +12,13 @@ on:
       - ".github/workflows/runner-image.yml"
   workflow_dispatch:
 
+# Workflow-level: read and nothing else. `packages: write` is granted on the
+# build job, which is the only thing that pushes an image, so a job added to
+# this file later does not inherit the ability to publish to the registry.
+# Scorecard flags the workflow-level form as `topLevel 'packages' permission
+# set to 'write'`.
 permissions:
   contents: read
-  packages: write
 
 concurrency:
   group: runner-image
@@ -38,6 +42,9 @@ defaults:
 
 jobs:
   build:
+    permissions:
+      contents: read
+      packages: write
     name: Build and publish
     # ubuntu-latest deliberately: the runner cannot be relied on to build the
     # image it is itself running, and this needs no estate access.
