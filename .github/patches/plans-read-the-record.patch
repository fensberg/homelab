--- /dev/null
+++ b/.github/workflows/upload-artifact/action.yml
@@ -0,0 +1,37 @@
+# The one place the actions/upload-artifact commit is written.
+#
+# tests/go/repo/action_pins_test.go allows an action's commit to be written
+# once; the converge's verdict and the as-built record from two workflows
+# needed it in three places.
+#
+# An empty retention-days is passed through as empty, which the action reads
+# as the repository's default.
+name: "Upload artifact"
+description: Upload files as an artifact of this run.
+
+inputs:
+  name:
+    description: The artifact's name.
+    required: true
+  path:
+    description: What to upload.
+    required: true
+  if-no-files-found:
+    description: warn, error or ignore.
+    required: false
+    default: warn
+  retention-days:
+    description: How long the artifact is kept; empty means the repository default.
+    required: false
+    default: ""
+
+runs:
+  using: composite
+  steps:
+    - name: Upload artifact
+      uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+      with:
+        name: ${{ inputs.name }}
+        path: ${{ inputs.path }}
+        if-no-files-found: ${{ inputs.if-no-files-found }}
+        retention-days: ${{ inputs.retention-days }}
