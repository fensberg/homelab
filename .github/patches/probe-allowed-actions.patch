diff --git a/.github/workflows/converge-estate.yml b/.github/workflows/converge-estate.yml
index 83fe45c3..7e0e7f61 100644
--- a/.github/workflows/converge-estate.yml
+++ b/.github/workflows/converge-estate.yml
@@ -90,3 +90,111 @@ jobs:
         env:
           OP_SERVICE_ACCOUNT_TOKEN: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
         run: go run -C scripts/lawyer . converge-estate
+
+  # Whether the allowed-actions setting the converge just applied lets
+  # through every action the approved suppliers list allows (#882).
+  #
+  # A pull request that changes the setting cannot prove it: its checks run
+  # under the setting already applied, and the new one first applies here.
+  # GitHub checks every action a job references while setting the job up,
+  # before any step runs - a skipped step's included. So this job references
+  # each allowed action in a step that never runs, and is refused at "Set up
+  # job" exactly when the setting refuses one: the same check every other job
+  # relies on, at the moment the setting changes. It runs nothing and holds
+  # nothing.
+  #
+  # Each commit is a witness, not a pin to keep current: the setting allows
+  # an action at every commit, so any real commit of it proves it.
+  # policy/conftest/rules/allowed_actions_probe holds this job to every
+  # allowed action and nothing else; the suppliers list names it under
+  # actions_probe.
+  probe-allowed-actions:
+    name: Prove the allowed actions
+    needs: converge
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    permissions: {}
+    steps:
+      - name: actions/cache
+        if: github.run_attempt == '0'
+        uses: actions/cache@27d5ce7f107fe9357f9df03efb73ab90386fccae
+
+      - name: actions/cache/restore
+        if: github.run_attempt == '0'
+        uses: actions/cache/restore@27d5ce7f107fe9357f9df03efb73ab90386fccae
+
+      - name: actions/cache/save
+        if: github.run_attempt == '0'
+        uses: actions/cache/save@27d5ce7f107fe9357f9df03efb73ab90386fccae
+
+      - name: actions/checkout
+        if: github.run_attempt == '0'
+        # zizmor reads this step as if it ran. It never does, so what it finds
+        # cannot happen: proved by TestTheConfigurationRulesHold, whose rule
+        # (policy/conftest/rules/allowed_actions_probe) holds every step of this
+        # job to the condition github.run_attempt == '0', which is never true.
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # zizmor: ignore[artipacked]
+
+      - name: actions/create-github-app-token
+        if: github.run_attempt == '0'
+        # zizmor reads this step as if it ran. It never does, so what it finds
+        # cannot happen: proved by TestTheConfigurationRulesHold, whose rule
+        # (policy/conftest/rules/allowed_actions_probe) holds every step of this
+        # job to the condition github.run_attempt == '0', which is never true.
+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # zizmor: ignore[github-app]
+
+      - name: actions/dependency-review-action
+        if: github.run_attempt == '0'
+        uses: actions/dependency-review-action@a1d282b36b6f3519aa1f3fc636f609c47dddb294
+
+      - name: actions/download-artifact
+        if: github.run_attempt == '0'
+        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
+
+      - name: actions/github-script
+        if: github.run_attempt == '0'
+        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3
+
+      - name: actions/setup-go
+        if: github.run_attempt == '0'
+        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e
+
+      - name: actions/setup-node
+        if: github.run_attempt == '0'
+        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
+
+      - name: actions/upload-artifact
+        if: github.run_attempt == '0'
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
+
+      - name: aquasecurity/setup-trivy
+        if: github.run_attempt == '0'
+        # zizmor reads this step as if it ran. It never does, so what it finds
+        # cannot happen: proved by TestTheConfigurationRulesHold, whose rule
+        # (policy/conftest/rules/allowed_actions_probe) holds every step of this
+        # job to the condition github.run_attempt == '0', which is never true.
+        uses: aquasecurity/setup-trivy@3fb12ec12f41e471780db15c232d5dd185dcb514 # zizmor: ignore[unpinned-tools]
+
+      - name: aquasecurity/trivy-action
+        if: github.run_attempt == '0'
+        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25
+
+      - name: github/codeql-action/analyze
+        if: github.run_attempt == '0'
+        uses: github/codeql-action/analyze@c16c0f3f2812ec4bb3750a5ed64873fe2ce0fbef
+
+      - name: github/codeql-action/init
+        if: github.run_attempt == '0'
+        uses: github/codeql-action/init@c16c0f3f2812ec4bb3750a5ed64873fe2ce0fbef
+
+      - name: github/codeql-action/upload-sarif
+        if: github.run_attempt == '0'
+        uses: github/codeql-action/upload-sarif@c16c0f3f2812ec4bb3750a5ed64873fe2ce0fbef
+
+      - name: ossf/scorecard-action
+        if: github.run_attempt == '0'
+        uses: ossf/scorecard-action@fa7117db83c52d787ae5a89f350999701505d78e
+
+      - name: pnpm/action-setup
+        if: github.run_attempt == '0'
+        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413
diff --git a/scripts/approved-suppliers.yml b/scripts/approved-suppliers.yml
index 1e16fb75..1645ac9c 100644
--- a/scripts/approved-suppliers.yml
+++ b/scripts/approved-suppliers.yml
@@ -924,6 +924,12 @@ egress:
       - api.github.com:443
       - github.com:443
 
+  - job: converge-estate.yml/probe-allowed-actions
+    policy: block
+    hosts:
+      - api.github.com:443
+      - github.com:443
+
   - job: converge-estate.yml/converge
     policy: audit
     reason: >-
@@ -1713,6 +1719,12 @@ actions:
   - action: pnpm/action-setup
     reason: Installs the pinned pnpm for the jobs that install the Node packages.
 
+# The job that proves the repository's allowed-actions setting straight after
+# the estate converge applies it (#882), as <workflow file>/<job>. What it
+# names is a witness that the setting lets an action through, not a use of
+# it, so the rules asking what the workflows use leave it out.
+actions_probe: converge-estate.yml/probe-allowed-actions
+
 exemptions: []
 
 # What kind of work each job on the estate's own runners is, and how long it
diff --git a/tests/silencers.yml b/tests/silencers.yml
index 0dfb7b40..ae153df6 100644
--- a/tests/silencers.yml
+++ b/tests/silencers.yml
@@ -164,6 +164,13 @@ tools:
 # Builds, fetches, formats or runs what it is given, and has no finding of
 # its own to silence.
 judges_nothing:
+  # The four below arrive only as witnesses in the allowed-actions probe
+  # (converge-estate.yml), whose steps never run; each is run for real by
+  # Trivy's actions, which judge.
+  actions/cache: keeps files between runs
+  actions/cache/restore: brings back files kept between runs
+  actions/cache/save: keeps files between runs
+  aquasecurity/setup-trivy: installs Trivy, which judges as trivy-action
   CILIUM_VERSION: the CNI's own manifests are rendered from it
   GATEWAY_API_VERSION: the version the rendered Gateway API definitions say they are
   TRAEFIK_CRDS_VERSION: the Gateway API's definitions are rendered from it
