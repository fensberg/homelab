 jobs:
+  # Whether the merge queue is being asked to test something that has already
+  # been tested.
+  #
+  # A pull request passes this workflow before it may join the queue, and the
+  # queue then runs it again on the pull request as it would land: on top of
+  # main as it now is, and of anything ahead of it. That second run says
+  # something only when the two differ. For a pull request that is level with
+  # main and alone in the queue they are the same files, and the same files
+  # give the same answer - six minutes spent hearing it twice.
+  #
+  # So this compares the two as trees, which is the files themselves and not
+  # the commits that carry them, and asks that this workflow did pass on the
+  # pull request's own head. When both hold, every lane below is skipped,
+  # which the queue reads as passed. When main has moved, or something is
+  # ahead in the queue, the trees differ and everything runs: which is the
+  # case the queue is for.
+  already-tested:
+    name: "Already tested (merge queue)"
+    if: github.event_name == 'merge_group'
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: read
+      actions: read
+    outputs:
+      identical: ${{ steps.compare.outputs.identical }}
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # Owned by scripts/approved-suppliers.yml under `egress:`, which says
+          # which job may reach what; `security guard-egress` refuses any drift.
+          egress-policy: block
+          disable-sudo-and-containers: "true"
+          allowed-endpoints: >
+            api.github.com:443
+            github.com:443
+
+      - name: Compare what the queue would land with what the pull request tested
+        id: compare
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPO: ${{ github.repository }}
+          QUEUED: ${{ github.event.merge_group.head_ref }}
+        run: |
+          identical=false
+          # The queue names its branch for the pull request at its head:
+          # gh-readonly-queue/<base>/pr-<number>-<the commit it sits on>.
+          number="$(sed -n 's#^refs/heads/gh-readonly-queue/.*/pr-\([0-9][0-9]*\)-[0-9a-f]*$#\1#p' <<<"${QUEUED}")"
+          if [ -z "${number}" ]; then
+            echo "::notice::the queue's branch is not named for one pull request, so everything runs"
+          else
+            git fetch --no-tags --depth=1 origin "refs/pull/${number}/head"
+            tested="$(git rev-parse 'FETCH_HEAD^{commit}')"
+            if [ "$(git rev-parse 'HEAD^{tree}')" != "$(git rev-parse 'FETCH_HEAD^{tree}')" ]; then
+              echo "::notice::what would land differs from pull request ${number} as it was tested, so everything runs"
+            else
+              passed="$(gh api "repos/${REPO}/actions/workflows/pr-validation.yml/runs?head_sha=${tested}&event=pull_request&status=success&per_page=1" --jq '.total_count')"
+              if [ "${passed}" -ge 1 ]; then
+                identical=true
+                echo "::notice::what would land is, file for file, pull request ${number} at ${tested}, which passed. Nothing is run again."
+              else
+                echo "::notice::pull request ${number} at ${tested} has no passing run of this workflow, so everything runs"
+              fi
+            fi
+          fi
+          echo "identical=${identical}" >> "$GITHUB_OUTPUT"
+
   # -----------------------------------------------------------------
   # LANE 1: Formatting - fast, and the only lane that also runs locally
   # -----------------------------------------------------------------
   format:
+    # Skipped, which the queue reads as passed, when the queue would land
+    # exactly what the pull request already tested (already-tested).
+    needs: already-tested
+    if: ${{ !cancelled() && needs.already-tested.outputs.identical != 'true' }}
