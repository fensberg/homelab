diff --git a/.github/workflows/checkout/action.yml b/.github/workflows/checkout/action.yml
index 8f4e383..e9628b7 100644
--- a/.github/workflows/checkout/action.yml
+++ b/.github/workflows/checkout/action.yml
@@ -1,8 +1,14 @@
 # The one place the actions/checkout commit is written.
 #
-# Most jobs reach this through $/.github/workflows/mobilize. A job that cannot
-# know what to fetch until it has run a few steps - the clerk resolves a pull
-# request number from a comment first - calls this directly, later.
+# Every job reaches this through $/.github/workflows/mobilize.
+#
+# IT CHECKS OUT THE COMMIT THE RUN IS FOR, AND NOTHING ELSE. There is no `ref`
+# input. It had one, and the one caller that used it - the clerk - checked out a
+# pull request's own code in a run holding the clerk App's private key, then
+# built and ran that code (#409). A shared checkout that any caller can point at
+# any ref is that hole made reusable, which is what CodeQL flagged here. A job
+# that needs to read other code fetches it as data, into its own worktree, and
+# does not run it.
 #
 # persist-credentials is not an input. No job here needs the token left on
 # disk, and leaving it lets any later step, or anything a later step runs, push
@@ -16,10 +22,6 @@ inputs:
     description: How much history to check out; 0 is all of it.
     required: false
     default: "1"
-  ref:
-    description: What to check out; empty means the commit that triggered the run.
-    required: false
-    default: ""
 
 runs:
   using: composite
@@ -28,5 +30,4 @@ runs:
       uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
       with:
         fetch-depth: ${{ inputs.fetch-depth }}
-        ref: ${{ inputs.ref }}
         persist-credentials: false
