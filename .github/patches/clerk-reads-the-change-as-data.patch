@@ -187,25 +191,48 @@ jobs:
           gh api -X POST "repos/$REPO/issues/comments/$COMMENT/reactions" -f content=confused --silent
           echo "::notice::known commands are '@clerk snag' and '@clerk handover'"
 
-      # refs/pull/N/head rather than the head SHA, and that is what makes a
-      # RETROACTIVE reading possible.
+      # The change is fetched as DATA, into its own worktree, and nothing in
+      # this job executes from it.
       #
-      # An issue_comment run starts on the default branch, so the change has to
-      # be fetched explicitly either way. But a merged pull request is the
-      # interesting case: this repository squash-merges, so the head commit is
-      # not an ancestor of main and its branch is deleted on merge - a checkout
-      # by SHA would find nothing. GitHub keeps refs/pull/N/head forever, so
-      # `@clerk snag` works on a pull request that landed months ago exactly as
-      # it does on one still open.
+      # It used to be checked out as the workspace. The job then ran
+      # ./.github/actions/versions and `go build -C scripts/clerk` from that
+      # checkout, and handed the binary the clerk App's private key (#409). On
+      # issue_comment this workflow runs from the default branch with secrets,
+      # whoever wrote the pull request - the association check above is about
+      # who ASKED, not who wrote the code - so an owner typing `@clerk snag` on
+      # a stranger's fork ran the stranger's code holding a credential that
+      # mints tokens for this repository.
       #
-      # That is worth having on purpose rather than by accident: it means the
-      # clerk can be pointed at work that was merged before it existed.
-      - name: Checkout Code
+      # Now the workspace is the commit this workflow runs from, the versions
+      # action and the clerk come from there, and the change is only ever read
+      # by -root. The head is checked against what "Resolve the change" saw, so
+      # a push landing between the two steps is refused rather than read.
+      #
+      # refs/pull/N/head rather than the head SHA, and that is what makes a
+      # RETROACTIVE reading possible. This repository squash-merges, so the head
+      # commit is not an ancestor of main and its branch is deleted on merge. A
+      # fetch by SHA would find nothing; GitHub keeps refs/pull/N/head forever,
+      # so `@clerk snag` works on a pull request that landed months ago exactly
+      # as it does on one still open.
+      #
+      # The token rides on the one command that needs it, rather than in
+      # .git/config - public repositories do not need it at all, and a fork of
+      # this estate might be private.
+      - name: Fetch the change to read, not to run
         if: steps.ask.outputs.verbs != ''
-        uses: $/.github/workflows/checkout
-        with:
-          ref: refs/pull/${{ steps.change.outputs.pr }}/head
-          fetch-depth: 0
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          PR: ${{ steps.change.outputs.pr }}
+          HEAD: ${{ steps.change.outputs.head }}
+        run: |
+          auth="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)"
+          git -c "http.extraheader=$auth" fetch --no-tags --quiet origin "refs/pull/$PR/head"
+          fetched="$(git rev-parse FETCH_HEAD)"
+          if [ "$fetched" != "$HEAD" ]; then
+            echo "::error::refs/pull/$PR/head is $fetched, not the $HEAD this run resolved. The pull request moved; ask again."
+            exit 1
+          fi
+          git worktree add --detach change "$HEAD"
 
       - name: Read pinned versions
         uses: ./.github/actions/versions
