diff --git a/.github/workflows/pr-validation.yml b/.github/workflows/pr-validation.yml
index e381b04..243e6ca 100644
--- a/.github/workflows/pr-validation.yml
+++ b/.github/workflows/pr-validation.yml
@@ -439,9 +439,26 @@ jobs:
           # scripts/contractor has none, so there is no go.sum of its own to key on.
           cache-dependency-path: tests/go/go.sum
 
+      # Every Go module under scripts/, discovered rather than listed.
+      #
+      # This step named scripts/contractor and nothing else, so the tests of
+      # signedpush, gatehouse, attestation, clerk, inspector and collector had
+      # never run in CI - including the guards that refuse an unsigned push and
+      # the program that reads the App private key. Two of those modules were
+      # absent from the taskfile's lists as well, so their tests had never run
+      # anywhere but the terminal that wrote them.
+      #
+      # A list of what to test is an allow list, and everything missing from it
+      # is invisible rather than red. taskfile.yml sweeps scripts/*/go.mod for
+      # the same reason; #281 covers removing this duplicate of it.
       - name: Unit and contract tests (Go)
-        working-directory: scripts/contractor
-        run: go test -covermode=atomic -coverprofile=coverage-go.out ./...
+        run: |
+          for dir in scripts/*/; do
+            [ -f "$dir/go.mod" ] || continue
+            echo "::group::$dir"
+            go test -C "$dir" -covermode=atomic -coverprofile=coverage-go.out ./...
+            echo "::endgroup::"
+          done
 
       # Every build tag, because `go vet ./...` compiles none of the tiers
       # that carry one. A compile error in the integration or e2e tier should
@@ -458,11 +475,20 @@ jobs:
       # Reported on every run, enforced as a ratchet: a pull request may not
       # push coverage below the committed floor, and is free to leave it
       # exactly where it found it. See tests/coverage-baseline.json.
+      # One floor per module. A single number over one module could not say
+      # which module had lost its tests, and six of the seven had no floor at
+      # all. The gate refuses a key it has no baseline for, so a new module
+      # fails here until its floor is written into tests/coverage-baseline.json.
       - name: Coverage gate (Go)
         run: |
-          pct="$(go -C scripts/contractor tool cover -func=coverage-go.out \
-            | awk '/^total:/ {print substr($3, 1, length($3)-1)}')"
-          bash scripts/coverage-gate.sh go "$pct"
+          for dir in scripts/*/; do
+            [ -f "$dir/go.mod" ] || continue
+            module="$(basename "$dir")"
+            go test -C "$dir" -covermode=atomic -coverprofile=coverage-go.out ./...
+            pct="$(go -C "$dir" tool cover -func=coverage-go.out \
+              | awk '/^total:/ {print substr($3, 1, length($3)-1)}')"
+            bash scripts/coverage-gate.sh "go/$module" "$pct"
+          done
 
       # --- OpenTofu --------------------------------------------------------
       - name: Install OpenTofu
