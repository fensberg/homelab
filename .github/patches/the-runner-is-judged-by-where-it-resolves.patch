diff --git a/.github/workflows/mobilize/action.yml b/.github/workflows/mobilize/action.yml
index 87f3de7..20bfed8 100644
--- a/.github/workflows/mobilize/action.yml
+++ b/.github/workflows/mobilize/action.yml
@@ -156,27 +156,34 @@ runs:
         fi
 
     - name: Whether this runner reaches what it is allowed
-      # The agent allows an address only when it has seen the name resolve
-      # through its own resolver. On some runners it holds the runner and the
-      # lookups go around it anyway, so it refuses every name - github.com,
-      # which every job's allowlist names, among them - and the job fails
-      # three fetches into its checkout on "exit code 128", which names
-      # neither (#791). Why the lookups go around it is not known. So this
-      # asks the way the checkout will, and where it is refused, says so,
-      # prints what the next such runner needs to show for the cause to be
-      # found, and stops. Nothing is tried again: a job cannot move itself
-      # to another runner, and the cause is not this job's to repair.
+      # The agent allows an address only when it has seen it resolve: the
+      # names it resolves itself when it starts, and every lookup made
+      # through the system's resolver, which it points at itself. On some of
+      # GitHub's runners /etc/resolv.conf is written by GitHub's own egress
+      # proxy (repoint-resolv-conf) and asks that proxy first, so lookups go
+      # around the agent (#791). A connection then works only where the
+      # proxy happens to answer with an address the agent also got - often
+      # for github.com, rarely for a name whose addresses rotate - and the
+      # job fails later, on "exit code 128" or "connection refused", naming
+      # neither. So this asks what the job's programs ask: a runner whose
+      # first nameserver is not the system resolver's stub is refused, and
+      # then github.com is asked for, the way the checkout will. Where either
+      # fails it prints how the runner resolves and stops. Nothing is tried
+      # again: a job cannot move itself to another runner, and the runner's
+      # resolver is not this job's to repair.
       if: inputs.egress-policy == 'block'
       shell: bash
       run: |
         said="$RUNNER_TEMP/reach-github"
-        if curl -sS -o /dev/null --max-time 15 https://github.com/ 2>"$said"; then
+        first="$(awk '$1 == "nameserver" { print $2; exit }' /etc/resolv.conf 2>/dev/null)"
+        if [ "$first" = "127.0.0.53" ] && curl -sS -o /dev/null --max-time 15 https://github.com/ 2>"$said"; then
           exit 0
         fi
         # Readable without sudo, which the agent has removed by now. The
         # agent's own log is printed by its post step, at the end of the job.
         echo "::group::What the runner said"
-        cat "$said" || true
+        echo "the first nameserver programs ask is ${first:-none}"
+        cat "$said" 2>/dev/null || true
         echo "::endgroup::"
         echo "::group::How the runner resolves"
         getent ahosts github.com || true
@@ -185,7 +192,7 @@ runs:
         echo "--- /etc/resolv.conf"
         cat /etc/resolv.conf || true
         echo "::endgroup::"
-        echo "::error::This runner cannot reach github.com, which this job is allowed to: the hardening agent holds the runner and its lookups go around the agent, so every name is refused (#791). Nothing in the change being tested caused this."
+        echo "::error::This runner's lookups go around the hardening agent: programs ask ${first:-no nameserver} first rather than the system resolver, so the agent refuses whatever it did not see resolve (#791). Nothing in the change being tested caused this."
         exit 1
 
     - name: Refuse an unrecognised value
