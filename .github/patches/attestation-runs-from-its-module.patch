diff --git a/.github/workflows/sensitive-paths.yml b/.github/workflows/sensitive-paths.yml
index a4d9faf..30c2325 100644
--- a/.github/workflows/sensitive-paths.yml
+++ b/.github/workflows/sensitive-paths.yml
@@ -123,19 +123,40 @@ jobs:
       # only as YAML inside a workflow is a convention somebody remembered to
       # write, and a convention fails.
       #
-      # tests/go/repo/tripwire_ack_test.go asserts this step exists and that
-      # nothing here has gone back to labels.
+      # tests/go/repo/tripwire_ack_test.go asserts this step exists, that the
+      # invocation is one that can actually run, and that nothing here has
+      # gone back to labels.
+      #
+      # `go run -C <dir> .` rather than `go run ./scripts/attestation`: this
+      # repository has no module at its root, deliberately - each program is
+      # its own module so one program's dependency is not every program's.
+      # From the root there is no main module to resolve a ./... path against,
+      # so the second form cannot ever work here. It shipped anyway, because
+      # the test asserted the string rather than the invocation.
+      #
+      # Every expansion is bound to an environment variable rather than
+      # interpolated into the script. A `${{ }}` inside `run:` is textual
+      # substitution into the shell source before bash sees it, so a value
+      # containing shell syntax becomes shell syntax; `$VAR` is a value
+      # whatever it holds. zizmor's template-injection audit is what enforces
+      # this, and it is the reason to write it this way even where the
+      # particular value is a digest that could not contain anything nasty.
       - name: Require an acknowledgement nobody gave themselves
         if: steps.sensor.outputs.tripped == 'true'
         env:
           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
           REPORT: ${{ steps.sensor.outputs.report }}
+          REPO: ${{ github.repository }}
+          PR: ${{ github.event.pull_request.number }}
+          DIGEST: ${{ steps.digest.outputs.digest }}
+          ANCHOR: ${{ steps.digest.outputs.anchor }}
+          HEAD: ${{ github.event.pull_request.head.sha }}
         run: |
           printf '%s' "$REPORT" >/tmp/sensitive-report.md
-          go run ./scripts/attestation \
-            -repo "${{ github.repository }}" \
-            -pr "${{ github.event.pull_request.number }}" \
-            -digest "${{ steps.digest.outputs.digest }}" \
-            -anchor "${{ steps.digest.outputs.anchor }}" \
-            -head "${{ github.event.pull_request.head.sha }}" \
+          go run -C scripts/attestation . \
+            -repo "$REPO" \
+            -pr "$PR" \
+            -digest "$DIGEST" \
+            -anchor "$ANCHOR" \
+            -head "$HEAD" \
             -report /tmp/sensitive-report.md
