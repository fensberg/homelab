diff --git a/.github/workflows/integration-tests.yml b/.github/workflows/integration-tests.yml
index b6b2158..18ac7b5 100644
--- a/.github/workflows/integration-tests.yml
+++ b/.github/workflows/integration-tests.yml
@@ -154,12 +154,34 @@ jobs:
           SITE: ${{ inputs.site || 'site0' }}
         run: ./scripts/contractor/contractor break-ground -site "$SITE" -phase backup -keep-on-failure
 
+      # Run through the contractor, not beside it.
+      #
+      # State is encrypted at rest, so a bare tofu invocation cannot read it -
+      # the lock rather than a side effect. This step had no vault token and no
+      # TF_ENCRYPTION, so every test that reaches the estate through
+      # `tofu output` failed on "Unsupported state file format". Five of seven
+      # did on 2026-09-05, and the run read as a broken suite rather than a
+      # missing variable (#227).
+      #
+      # The contractor establishes the passphrase from the vault before any
+      # verb and passes its own environment to whatever it runs, so wrapping
+      # the tier in an existing verb is all this needs - no new surface, and
+      # one implementation of the encryption block rather than a second copy
+      # in the test harness that could drift from it.
+      #
+      # `kubeconfig` specifically because the tier wants both credentials: the
+      # tests read the estate's state AND talk to the cluster. The kubeconfig
+      # goes to a mode-0600 temp file that is removed on every exit path,
+      # including a signal.
       - name: Integration tests
         if: ${{ github.event_name == 'schedule' || inputs.tier == 'integration' || inputs.tier == 'both' }}
         env:
+          OP_SERVICE_ACCOUNT_TOKEN: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
           HOMELAB_TEST_SITE: ${{ inputs.site || 'site0' }}
-        working-directory: tests/go
-        run: go test -tags=integration -timeout 20m -v ./integration/...
+          SITE: ${{ inputs.site || 'site0' }}
+        run: >-
+          ./scripts/contractor/contractor kubeconfig -site "$SITE" --
+          go test -C tests/go -tags=integration -timeout 20m -v ./integration/...
 
       # always(), because the whole point is that no secret survives this job
       # whatever happened above. A self-hosted runner is a long-lived machine:
