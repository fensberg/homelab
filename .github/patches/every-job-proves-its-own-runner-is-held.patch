diff --git a/.github/workflows/mobilize/action.yml b/.github/workflows/mobilize/action.yml
index 6c63710..4b1b097 100644
--- a/.github/workflows/mobilize/action.yml
+++ b/.github/workflows/mobilize/action.yml
@@ -80,6 +80,32 @@ runs:
     #
     # This runs after harden-runner rather than before it, because harden-runner
     # is what makes every later step watched - including this one.
+    # ON THIS RUNNER, AND NOT ON SOME OTHER. Every job has a runner of its
+    # own and its own copy of what hardens it, so a proof on one says nothing
+    # of the next. On 2026-10-12 the agent failed to start on about one
+    # runner in seven - it could not take the port its resolver listens on -
+    # and a job on such a runner has no block on what it reaches and still
+    # has sudo, with nothing saying so. It was noticed twice, because it
+    # twice fell on the one lane that looks.
+    #
+    # So every job that asks for sudo to be gone looks for itself, before
+    # anything else it does: sudo that still works is a runner where
+    # enforcement is not in place, and the job stops there. It costs nothing.
+    # The lane that proves a refused address is refused is still its own
+    # (pr-validation.yml), since that one needs somewhere to be refused by.
+    #
+    # Only where sudo was to be removed. A job that keeps it says why beside
+    # its entry in scripts/approved-suppliers.yml, and a runner on the estate
+    # is not hardened by this at all.
+    - name: This runner is held, or the job stops
+      if: inputs.disable-sudo-and-containers == 'true'
+      shell: bash
+      run: |
+        if sudo -n true 2>/dev/null; then
+          echo "::error::sudo still works on this runner after it was to be removed, so what hardens the runner did not start here: nothing blocks what this job reaches, and a later step could switch enforcement off. Run the job again; it gets another runner."
+          exit 1
+        fi
+
     - name: Refuse an unrecognised value
       if: >-
         (inputs.checkout != 'true' && inputs.checkout != 'false') ||
