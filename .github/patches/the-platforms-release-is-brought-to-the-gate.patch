diff --git a/.github/workflows/fabricator.yml b/.github/workflows/fabricator.yml
index 362cb3c..7245883 100644
--- a/.github/workflows/fabricator.yml
+++ b/.github/workflows/fabricator.yml
@@ -871,3 +871,123 @@ jobs:
                   gh pr close "$old" --repo "$REPO" --delete-branch --comment "Superseded by ${url##*/}, which delivers a newer release." >/dev/null
                 done
           done < <(jq -r '.[] | select(.release) | .name' <<<"$ORDERS")
+
+  # ---------------------------------------------------------------------
+  # THE PLATFORM'S RELEASE, BROUGHT TO THE GATE.
+  #
+  # Publishing a release of the platform deploys nothing: a site runs the
+  # release its own line names (management/versions.json). Moving that line
+  # was done by hand, by whoever remembered a release had been published.
+  # It is delivered now as an application's release is: when the newest
+  # release is not the one every site's line names, procurement opens a pull
+  # request that moves the lines and changes nothing else.
+  #
+  # Opened, and not merged. The pull request's plan says what the release
+  # would do to each site, and letting it in is a person's, as every
+  # delivery is.
+  #
+  # A job of its own, behind the packaging and not behind the builds: a
+  # merge that changed only the platform builds nothing, and a job that
+  # waited on the builds would be passed over with them.
+  # ---------------------------------------------------------------------
+  deliver-platform:
+    name: Bring the platform's release to the gate
+    needs: [orders, package]
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - name: Mobilize
+        uses: $/.github/workflows/mobilize
+        with:
+          # Owned by scripts/approved-suppliers.yml under `egress:`.
+          egress-policy: block
+          disable-sudo-and-containers: "true"
+          allowed-endpoints: >
+            api.github.com:443
+            github.com:443
+            go.dev:443
+            objects.githubusercontent.com:443
+            proxy.golang.org:443
+            release-assets.githubusercontent.com:443
+            storage.googleapis.com:443
+            sum.golang.org:443
+
+      - name: Read pinned versions
+        uses: $/.github/actions/versions
+
+      - name: Setup Go
+        uses: $/.github/workflows/setup-go
+
+      # Procurement's token, not the job's own: a pull request opened with
+      # the job's token starts no workflow, so its plan would never be made.
+      - name: Mint the procurement token
+        id: token
+        uses: $/.github/workflows/app-token
+        with:
+          client-id: ${{ secrets.PROCUREMENT_BOT_CLIENT_ID }}
+          private-key: ${{ secrets.PROCUREMENT_BOT_PRIVATE_KEY }}
+          permission-contents: write
+          permission-pull-requests: write
+          owner: ${{ github.repository_owner }}
+          repositories: ${{ github.event.repository.name }}
+
+      - name: Deliver
+        env:
+          GH_TOKEN: ${{ steps.token.outputs.token }}
+          READ_TOKEN: ${{ github.token }}
+          REPO: ${{ github.repository }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          set -euo pipefail
+          # The newest release, as the packaging job described it: its
+          # version is the tag and what it was published as is in its notes.
+          version="$(GH_TOKEN="$READ_TOKEN" gh api "repos/${REPO}/releases/latest" --jq .tag_name)"
+          digest="$(GH_TOKEN="$READ_TOKEN" gh api "repos/${REPO}/releases/latest" --jq .body | grep -oE 'sha256:[0-9a-f]{64}' | head -n 1 || true)"
+          if [[ ! "$version" =~ ^v20[0-9]{2}\.[0-9]+\.[0-9]+$ ]] || [[ ! "$digest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
+            echo "::error::the newest release does not say a version of the platform and what it was published as, so there is nothing to deliver"
+            exit 1
+          fi
+
+          main="$(gh api "repos/${REPO}/git/ref/heads/main" --jq .object.sha)"
+          base_tree="$(gh api "repos/${REPO}/git/commits/${main}" --jq .tree.sha)"
+          pins="management/versions.json"
+          moved="$RUNNER_TEMP/versions.json"
+          gh api "repos/${REPO}/contents/${pins}?ref=${main}" --jq .content | base64 -d > "$moved"
+          before="$(sha256sum < "$moved")"
+          go run -C scripts/procurement . deliver-platform -pins "$moved" -version "$version" -digest "$digest"
+          if [ "$(sha256sum < "$moved")" = "$before" ]; then
+            echo "the platform: every site already runs ${version}" >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+
+          branch="deliver/platform-${version}"
+          if [ -n "$(gh pr list --repo "$REPO" --head "$branch" --state open --json number --jq '.[0].number // empty')" ]; then
+            echo "the platform: ${version} is already at the gate" >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+
+          blob="$(gh api "repos/${REPO}/git/blobs" -f content="$(base64 -w0 "$moved")" -f encoding=base64 --jq .sha)"
+          tree="$(gh api "repos/${REPO}/git/trees" -f base_tree="$base_tree" \
+            -f "tree[][path]=${pins}" -f "tree[][mode]=100644" -f "tree[][type]=blob" -f "tree[][sha]=${blob}" --jq .sha)"
+          commit="$(gh api "repos/${REPO}/git/commits" -f tree="$tree" -f "parents[]=${main}" \
+            -f message="feat(platform): release ${version}" --jq .sha)"
+          gh api "repos/${REPO}/git/refs" -f ref="refs/heads/${branch}" -f sha="$commit" >/dev/null
+          url="$(gh pr create --repo "$REPO" --base main --head "$branch" --title "feat(platform): release ${version}" \
+            --body "$(printf '%s\n' \
+              "## Actions for you" "" \
+              "Read the plan below before merging: it says what this release would do to each site. Merging converges every site onto it." "" \
+              "## What this is" "" \
+              "The fabricator published the platform as \`${version}\` (\`${digest}\`). This moves each site's line in \`${pins}\` to it, and changes nothing else." "" \
+              "Procurement opened this; it is never merged without review." "" \
+              "Delivered by: ${RUN_URL}")")"
+          echo "the platform: ${version} delivered as ${url##*/}" >> "$GITHUB_STEP_SUMMARY"
+
+          # An older release still at the gate is behind this one, and
+          # merging it would move the sites backwards.
+          gh pr list --repo "$REPO" --state open --json number,headRefName \
+            --jq ".[] | select(.headRefName | startswith(\"deliver/platform-\")) | select(.headRefName != \"${branch}\") | .number" \
+            | while IFS= read -r old; do
+                gh pr close "$old" --repo "$REPO" --delete-branch --comment "Superseded by ${url##*/}, which delivers a newer release." >/dev/null
+              done
