# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# Ignore dynamically rendered 1Password files
*.rendered.yml
*.rendered.json
config/management.placeholder.json
inventory.yml
/tmp/kubeconfig

# Rendered at migration time, never committed
management/cluster/backend_pg.tf

# Tailscale auth key handed to Ansible by the Overlay phase
management/hypervisor/overlay-network.auto.yml


# Per-site network values generated by the Render phase
management/hypervisor/site.auto.yml

state-backup.key

# Points at a real hypervisor; not for git
workstation/inventory.yml

# The ignite binary. taskfile.yml builds it here on purpose rather than using
# `go run`, whose wrapper process has no signal handler of its own - see the
# comment at the top of taskfile.yml.
scripts/ignite/ignite

# --- test artefacts ---------------------------------------------------------
# Coverage output. The committed part of coverage is tests/coverage-baseline.json,
# which is the floor; the measurements themselves are per-run and disposable.
scripts/ignite/coverage-go.out
coverage/

# Go test binaries, if anyone runs `go test -c`
*.test

# JavaScript/TypeScript. node_modules is reproducible from pnpm-lock.yaml,
# which IS committed - that lock file is what pins the tier.
node_modules/
playwright-report/
test-results/
.playwright/

# Written on demand by `task kubeconfig`. A credential, and deliberately
# transient - the Sterilize phase removes it like everything else here.
management/cluster/kubeconfig
