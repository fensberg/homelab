#!/usr/bin/env bash
# The interception point.
#
# pre-commit clones a hook repository and installs its environment BEFORE it
# runs any hook, and installing runs setup code - npm install, pip install, a
# Go build. A guard that is itself a pre-commit hook therefore runs after the
# thing it is guarding against has already executed. That is the limit the
# earlier version admitted to and this closes.
#
# git invokes this file. Nothing third-party has run yet. So the guard runs
# here, and pre-commit is only reached if it passes.
#
# Wired up by `git config core.hooksPath githooks`, which
# scripts/install-dependencies.sh sets. Versioned in the repository on purpose:
# a hook that lives only in .git/hooks is a hook nobody can review, and
# `pre-commit install` overwrites it anyway.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Built rather than `go run`: this is on the path of every commit, and the
# binary is cached between them.
go build -C scripts/security -o ../../toolshed/security .
./toolshed/security guard-deliveries

# Only now. Anything below this line may download and execute third-party code.
# pre-commit's own entry point, with the arguments its generated hook uses.
#
# Not `pre-commit run --hook-stage pre-commit`: that form does not receive the
# ref information git passes on stdin and in argv, so PRE_COMMIT_REMOTE_BRANCH
# and its siblings are unset - and the push guard, which fails closed when it
# cannot tell which ref a push would update, refuses every push. Found by
# breaking exactly that.
# Dispatch to pre-commit the way its own generated hook does, rather than
# assuming `pre-commit` is on PATH.
#
# The generated hook tries an interpreter first and falls back to the command;
# these shims only ever did the command. That drops two things (#257):
#
#   1. The module fallback. `pip install --user pre-commit` puts the module in
#      site-packages while leaving ~/.local/bin off PATH on plenty of systems,
#      so `pre-commit` is not a command and `python3 -mpre_commit` is.
#   2. The diagnostic. `pre-commit: command not found` says what happened;
#      "did you forget to activate your virtualenv" says what to do about it.
#
# Both failures are loud either way - no pre-commit means a non-zero exit and a
# refused commit - so this is about the second of the two being actionable, not
# about anything passing that should not.
args=(
	hook-impl
	--config=.pre-commit-config.yaml
	--hook-type=pre-commit
	--hook-dir "$root/githooks"
	--
	"$@"
)
if command -v pre-commit >/dev/null 2>&1; then
	exec pre-commit "${args[@]}"
elif python3 -c 'import pre_commit' >/dev/null 2>&1; then
	exec python3 -mpre_commit "${args[@]}"
else
	echo 'pre-commit not found. Did you forget to activate your virtualenv?' >&2
	echo 'Install it with ./scripts/install-dependencies.sh' >&2
	exit 1
fi
