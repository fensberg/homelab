#!/usr/bin/env bash
# Same interception point, for the push hooks.
#
# The supplier guard runs here too rather than only on commit: a clone can
# arrive between a commit and a push - a rebase, a config change pulled from a
# branch, `pre-commit install-hooks` run by hand - and a push is the last
# moment before code leaves this machine.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

go build -C scripts/security -o ../../toolshed/security .
./toolshed/security guard-deliveries

# pre-commit's own entry point, with the arguments its generated hook uses.
#
# Not `pre-commit run --hook-stage pre-push`: that form does not receive the
# ref information git passes on stdin and in argv, so PRE_COMMIT_REMOTE_BRANCH
# and its siblings are unset - and the push guard, which fails closed when it
# cannot tell which ref a push would update, refuses every push. Found by
# breaking exactly that.
# Dispatch to pre-commit, found where scripts/take-delivery.sh puts it.
#
# pre-commit, and the delivered-python its checks run with, are installed into
# an isolated environment and linked into ~/.local/bin (#416, #423). Not every
# login puts that directory on PATH - Debian's ~/.profile adds it only if it
# existed when the session started, so the first shell after setup does not
# have it. Adding it here means a hook finds its tools on that first commit
# rather than refusing it.
#
# There used to be a second route, `python3 -mpre_commit`, for a pre-commit
# installed with pip --user and reachable only as a module (#257). It is gone
# on purpose: the system Python no longer holds pre-commit, and one that did
# would be a copy nothing locked by hash.
PATH="$HOME/.local/bin:$PATH"
args=(
	hook-impl
	--config=.pre-commit-config.yaml
	--hook-type=pre-push
	--hook-dir "$root/githooks"
	--
	"$@"
)
if ! command -v pre-commit >/dev/null 2>&1; then
	echo "pre-commit not found, including in $HOME/.local/bin, so no hook can run." >&2
	echo 'Take delivery of it with ./scripts/install-dependencies.sh' >&2
	exit 1
fi
exec pre-commit "${args[@]}"
