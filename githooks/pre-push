#!/usr/bin/env bash
# Same interception point, for the push hooks.
#
# The supplier guard runs here too rather than only on commit: a clone can
# arrive between a commit and a push - a rebase, a config change pulled from a
# branch, `pre-commit install-hooks` run by hand - and a push is the last
# moment before code leaves this machine.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

go build -C scripts/supplierguard -o supplierguard .
./scripts/supplierguard/supplierguard

# pre-commit's own entry point, with the arguments its generated hook uses.
#
# Not `pre-commit run --hook-stage pre-push`: that form does not receive the
# ref information git passes on stdin and in argv, so PRE_COMMIT_REMOTE_BRANCH
# and its siblings are unset - and the push guard, which fails closed when it
# cannot tell which ref a push would update, refuses every push. Found by
# breaking exactly that.
exec pre-commit hook-impl \
	--config=.pre-commit-config.yaml \
	--hook-type=pre-push \
	--hook-dir "$root/githooks" \
	-- "$@"
